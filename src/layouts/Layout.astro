---
import PasswordGate from "../components/PasswordGate.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/assets/images/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <link
      href="https://fonts.googleapis.com/css2?family=Stack+Sans+Text:wght@200..700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("password-locked");
    </script>

    <title>Adrian Glasmyre | Brand & Digital Designer</title>
  </head>
  <body>
    <PasswordGate>
      <slot />
    </PasswordGate>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>

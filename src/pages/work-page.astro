---
import Navbar from "../components/Navbar.astro";
import CTA from "../components/CTA.astro";
import arrow from "../assets/arrow.svg";
import type { WorkFile } from "./work/types";
import "../styles/global.css";

// Load all work items
const allWork = Object.values(
  import.meta.glob("../content/work/*.md", { eager: true })
) as WorkFile[];
---

<div class="main-wrapper">
  <Navbar />

  <section class="work-page">
    <h1 class="flower-heading">My Work</h1>
    <div class="project-items">
      {
        allWork.map((work) => (
          <a
            href={`/work/${work.frontmatter.slug}`}
            class="project-item"
            aria-label={`View project: ${work.frontmatter.title}`}
          >
            <img
              class="project-image"
              src={work.frontmatter.cardImage.src}
              alt={work.frontmatter.cardImage.alt}
              width="100%"
              height="100%"
            />

            <div class="project-info">
              <h3>{work.frontmatter.title}</h3>
              <p>{work.frontmatter.shortDescription}</p>

              <div class="link-btn">
                <span class="view-project">View Project</span>

                <span class="icon-circle">
                  <img
                    class="arrow"
                    src={arrow.src}
                    width="18"
                    height="18"
                    alt=""
                    aria-hidden="true"
                  />
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <CTA />
</div>

<style>
  .work-page {
    padding: 50px 0;
  }

  .icon-circle {
    background-color: var(--berry-crush);
    width: 35px;
    height: 35px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 100px;
  }

  .link-btn {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .project-item {
    display: block;
    text-decoration: none;
    color: inherit;
    background-color: #fff;
    padding: 18px;
    border-radius: 30px;
  }

  .link-btn span {
    font-family: "Stack Sans Text";
    text-transform: uppercase;
    color: var(--berry-crush);
    font-size: 20px;
    font-weight: 700;
  }

  .project-item:hover .link-btn span {
    color: var(--navy-blue);
  }

  .project-image {
    border-radius: 20px;
    height: auto;
    width: 100%;
  }

  .project-items {
    display: grid;
    gap: 30px;
  }

  .project-info {
    margin-top: 15px;
  }

  .project-info h3 {
    margin-bottom: 10px;
  }

  .project-info p {
    margin-bottom: 15px;
  }

  @media (min-width: 768px) {
    .project-items {
      grid-template-columns: repeat(2, 1fr);
    }

    .project-item:hover {
      box-shadow: 0px 0px 20px #0e171b29;
      transform: translateY(-2px);
    }

    .project-item:hover .link-btn .icon-circle {
      background-color: var(--navy-blue);
    }

    .project-item {
      transition:
        background-color 0.25s ease,
        box-shadow 0.25s ease,
        transform 0.25s ease;
    }
  }

  @media (min-width: 1280px) {
    .project-items {
      grid-template-columns: repeat(3, 1fr);
    }

    .project-item p {
      margin: 10px 0;
    }

    .project-item {
      padding: 25px;
    }

    .project-image {
      margin-bottom: 20px;
      height: 375px;
      object-fit: cover;
    }
  }
</style>

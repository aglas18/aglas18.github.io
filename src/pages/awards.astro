---
import Navbar from "~/components/Navbar.astro";
import CTA from "~/components/CTA.astro";
import Layout from "../layouts/Layout.astro";
import "~/styles/global.css";

import arrow from "~/assets/arrow.svg";
import close from "~/assets/close.svg";
import { awardsList } from "~/content/awards/Awards";

const agencyAwards = awardsList.filter(
  (award) => award.category === "Agency Awards",
);
const teamProjects = awardsList.filter(
  (award) => award.category === "Team Projects",
);
const internalRecognition = awardsList.filter(
  (award) => award.category === "Internal Recognition",
);
---

<Layout>
  <div class="main-wrapper">
    <Navbar />

    <div class="innerpage-masthead">
      <h1>Awards</h1>
    </div>

    <!-- Agency Awards -->
    <h2 class="flower-heading">Agency Awards</h2>
    <div class="awards-block">
      {
        agencyAwards.map((award, index) => (
          <button
            class="award-item"
            data-award-index={index}
            data-category="agency"
            type="button"
          >
            <div class="award-info">
              <h5>{award.date}</h5>
              <h3>{award.title}</h3>
              <p>{award.description}</p>

              <div class="link-btn">
                <span class="view-project">Read More</span>
                <span class="icon-circle">
                  <img
                    src={arrow.src}
                    width="18"
                    height="18"
                    alt=""
                    aria-hidden="true"
                  />
                </span>
              </div>
            </div>
          </button>
        ))
      }
    </div>

    <!-- Team Projects -->
    <h2 class="flower-heading">Team Projects & Performance</h2>
    <div class="awards-block">
      {
        teamProjects.map((award, index) => (
          <div class="award-item award-item-static">
            <div class="award-info">
              <h5>{award.date}</h5>
              <h3>{award.title}</h3>
              <p>{award.description}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Internal Recognition -->
    <h2 class="flower-heading">Internal Recognition & Peer Awards</h2>
    <div class="awards-block">
      {
        internalRecognition.map((award, index) => (
          <button
            class="award-item"
            data-award-index={index}
            data-category="internal"
            type="button"
          >
            <div class="award-info">
              <h5>{award.date}</h5>
              <h3>{award.title}</h3>
              <p>{award.description}</p>

              <div class="link-btn">
                <span class="view-project">Read More</span>
                <span class="icon-circle">
                  <img
                    src={arrow.src}
                    width="18"
                    height="18"
                    alt=""
                    aria-hidden="true"
                  />
                </span>
              </div>
            </div>
          </button>
        ))
      }
    </div>

    <!-- Award Popup Modal -->
    <div class="award-popup" id="award-popup" aria-hidden="true">
      <div class="popup-overlay"></div>
      <div class="popup-content">
        <button class="popup-close" aria-label="Close popup">
          <img
            src={close.src}
            width="24"
            height="24"
            alt=""
            aria-hidden="true"
          />
        </button>
        <div class="popup-body">
          <h5 id="popup-date"></h5>
          <h3 id="popup-title"></h3>
          <p id="popup-content"></p>
        </div>
      </div>
    </div>

    <CTA />
  </div>
</Layout>

<style>
  .icon-circle {
    background-color: var(--berry-crush);
    width: 35px;
    height: 35px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 100px;
  }

  .link-btn {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .awards-block:not(:last-of-type) {
    padding-bottom: 60px; /* even smaller on small phones */
  }

  .award-item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background-color: #fff;
    padding: 18px;
    border-radius: 30px;
    border: none;
    cursor: pointer;
    text-align: left;
    width: 100%;
    font-family: inherit;
    height: 100%;
  }

  .award-item-static {
    cursor: default;
  }

  .award-item-static:hover {
    box-shadow: none;
    transform: none;
  }

  .award-info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    height: 100%;
  }

  .award-info h5,
  .award-info h3,
  .award-info p {
    margin: 0;
  }

  .award-info h5 {
    margin-bottom: 8px;
  }

  .award-info h3 {
    margin-bottom: 12px;
  }

  .award-info p {
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .link-btn {
    margin-top: auto;
  }

  .link-btn span {
    font-family: "Stack Sans Text";
    text-transform: uppercase;
    color: var(--berry-crush);
    font-size: 20px;
    font-weight: 700;
  }

  .award-item:hover .link-btn span {
    color: var(--navy-blue);
  }

  .awards-block {
    display: grid;
    gap: 30px;
    align-items: stretch;
  }

  .innerpage-masthead h1 {
    margin: 0px;
    color: white;
  }

  .innerpage-masthead {
    background: var(--gradient-accent);
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-radius: 30px;
    margin-bottom: 60px;
  }

  @media (min-width: 768px) {
    .awards-block {
      grid-template-columns: repeat(2, 1fr);
    }

    .award-item:not(.award-item-static):hover {
      box-shadow: 0px 0px 20px #0e171b29;
      transform: translateY(-2px);
    }

    .award-item:not(.award-item-static):hover .link-btn a {
      color: var(--navy-blue);
    }

    .award-item:not(.award-item-static):hover .link-btn .icon-circle {
      background-color: var(--navy-blue);
    }

    .award-item:not(.award-item-static) {
      transition:
        background-color 0.25s ease,
        box-shadow 0.25s ease,
        transform 0.25s ease;
    }

    .awards-block:not(:last-of-type) {
      padding-bottom: 75px;
    }
  }

  @media (min-width: 1280px) {
    .awards-block {
      grid-template-columns: repeat(3, 1fr);
    }

    .award-item p {
      margin: 10px 0;
    }

    .award-item {
      padding: 25px;
    }

    .awards-block:not(:last-of-type) {
      padding-bottom: 100px;
    }

    .innerpage-masthead {
      padding: 100px 40px 40px 40px;
      margin-bottom: 100px;
    }
  }

  /* ===== POPUP MODAL ===== */
  .award-popup {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 24px;
  }

  .award-popup.active {
    display: flex;
  }

  .popup-overlay {
    position: absolute;
    inset: 0;
    background: rgba(14, 23, 27, 0.85);
    backdrop-filter: blur(4px);
  }

  .popup-content {
    position: relative;
    background: white;
    border-radius: 30px;
    padding: 40px 30px;
    max-width: 600px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    z-index: 1;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .popup-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background-color 0.2s ease;
  }

  .popup-close:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .popup-close img {
    filter: brightness(0) saturate(100%) invert(0%) sepia(0%) saturate(0%)
      hue-rotate(0deg) brightness(0%) contrast(100%);
  }

  .popup-body h5 {
    color: var(--berry-crush);
    font-size: 16px;
    margin-bottom: 12px;
    font-weight: 600;
  }

  .popup-body h3 {
    color: var(--ink-black);
    font-size: 24px;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .popup-body p {
    color: var(--ink-black);
    font-size: 16px;
    line-height: 1.6;
    white-space: pre-wrap;
  }

  @media (min-width: 768px) {
    .popup-content {
      padding: 50px 40px;
      max-width: 700px;
    }

    .popup-body h3 {
      font-size: 28px;
    }

    .popup-body p {
      font-size: 18px;
    }
  }

  body.popup-open {
    overflow: hidden;
  }
</style>

<script define:vars={{ agencyAwards, teamProjects, internalRecognition }}>
  const allAwards = [...agencyAwards, ...teamProjects, ...internalRecognition];

  const awardItems = document.querySelectorAll(".award-item");
  const popup = document.getElementById("award-popup");
  const popupClose = document.querySelector(".popup-close");
  const popupOverlay = document.querySelector(".popup-overlay");
  const popupDate = document.getElementById("popup-date");
  const popupTitle = document.getElementById("popup-title");
  const popupContent = document.getElementById("popup-content");

  function openPopup(award) {
    if (award.linkUrl) {
      // If award has a linkUrl, navigate to it
      window.open(award.linkUrl, "_blank", "noopener,noreferrer");
      return;
    }

    if (award.popupContent) {
      // Show popup with content
      popupDate.textContent = award.date;
      popupTitle.textContent = award.title;
      popupContent.textContent = award.popupContent;
      popup.classList.add("active");
      popup.setAttribute("aria-hidden", "false");
      document.body.classList.add("popup-open");
    }
  }

  function closePopup() {
    popup.classList.remove("active");
    popup.setAttribute("aria-hidden", "true");
    document.body.classList.remove("popup-open");
  }

  awardItems.forEach((item) => {
    // Skip static items (Team Projects)
    if (item.classList.contains("award-item-static")) {
      return;
    }

    item.addEventListener("click", () => {
      const category = item.getAttribute("data-category");
      const awardIndex = parseInt(item.getAttribute("data-award-index") || "0");

      let award;
      if (category === "agency") {
        award = allAwards[awardIndex];
      } else {
        award =
          allAwards[agencyAwards.length + teamProjects.length + awardIndex];
      }

      openPopup(award);
    });
  });

  popupClose?.addEventListener("click", closePopup);
  popupOverlay?.addEventListener("click", closePopup);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && popup?.classList.contains("active")) {
      closePopup();
    }
  });
</script>

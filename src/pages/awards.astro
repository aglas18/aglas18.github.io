---
import Navbar from "~/components/Navbar.astro";
import CTA from "~/components/CTA.astro";
import Layout from "../layouts/Layout.astro";
import "~/styles/global.css";

import arrow from "~/assets/arrow.svg";
import close from "~/assets/close.svg";
import { awardsList } from "~/content/awards/Awards";

// Helper function to parse dates for sorting
function parseDate(dateStr: string): number {
  // Handle year-only dates (e.g., "2024")
  if (/^\d{4}$/.test(dateStr)) {
    return parseInt(dateStr);
  }
  // Handle date ranges (e.g., "2022–2025") - use the end year
  if (dateStr.includes("–")) {
    const endYear = dateStr.split("–")[1];
    return parseInt(endYear) || 0;
  }
  // Handle month + year (e.g., "Jan 2024", "Apr 2024")
  const monthNames: { [key: string]: number } = {
    Jan: 1,
    Feb: 2,
    Mar: 3,
    Apr: 4,
    May: 5,
    Jun: 6,
    Jul: 7,
    Aug: 8,
    Sep: 9,
    Oct: 10,
    Nov: 11,
    Dec: 12,
  };
  const parts = dateStr.split(" ");
  if (parts.length === 2 && monthNames[parts[0]]) {
    return parseInt(parts[1]) * 100 + monthNames[parts[0]];
  }
  return 0;
}

// Sort awards from newest to oldest
const agencyAwards = awardsList
  .filter((award) => award.category === "Agency Awards")
  .sort((a, b) => parseDate(b.date) - parseDate(a.date));

const teamProjects = awardsList
  .filter((award) => award.category === "Team Projects")
  .sort((a, b) => parseDate(b.date) - parseDate(a.date));

const internalRecognition = awardsList
  .filter((award) => award.category === "Internal Recognition")
  .sort((a, b) => parseDate(b.date) - parseDate(a.date));

// Emoji mapping for awards
function getAwardEmoji(title: string): string {
  if (title.includes("Platinum Phone")) return "💎";
  if (title.includes("Shiny Semi")) return "🚚";
  if (title.includes("Needle Driver")) return "🎯";
  if (title.includes("Designasaur")) return "🦖";
  if (title.includes("Horizon Award")) return "🥇";
  if (title.includes("Highest Conversion Rate")) return "📈";
  if (title.includes("Fastest")) return "⚡";
  if (title.includes("Most Profitable")) return "💰";
  return "🏆";
}
---

<Layout>
  <div class="main-wrapper">
    <Navbar />
    <div class="innerpage-masthead">
      <h1>Recognition & Achievements</h1>
    </div>
    <div class="content-wrapper">
      <!-- Internal Recognition -->
      <h2 class="flower-heading">Internal Recognition & Peer Awards</h2>
      <p class="section-description">
        Awards and recognition received for individual contributions,
        communication excellence, and outstanding design work.
      </p>
      <div class="awards-block">
        {
          internalRecognition.map((award, index) =>
            award.popupContent ? (
              <button
                class="award-item"
                data-award-index={index}
                data-category="internal"
                type="button"
              >
                <div class="award-info">
                  <div class="award-header">
                    <span class="award-emoji">
                      {getAwardEmoji(award.title)}
                    </span>
                    <div>
                      <h5>{award.date}</h5>
                      <h3>{award.title}</h3>
                    </div>
                  </div>
                  <p>{award.description}</p>

                  <div class="link-btn">
                    <span class="view-project">Read More</span>
                    <span class="icon-circle">
                      <img
                        src={arrow.src}
                        width="18"
                        height="18"
                        alt=""
                        aria-hidden="true"
                      />
                    </span>
                  </div>
                </div>
              </button>
            ) : (
              <div class="award-item award-item-static">
                <div class="award-info">
                  <div class="award-header">
                    <span class="award-emoji">
                      {getAwardEmoji(award.title)}
                    </span>
                    <div>
                      <h5>{award.date}</h5>
                      <h3>{award.title}</h3>
                    </div>
                  </div>
                  <p>{award.description}</p>
                </div>
              </div>
            ),
          )
        }
      </div>

      <!-- Agency Awards -->
      <h2 class="flower-heading">Agency Recognition</h2>
      <p class="section-description">
        Awards presented to the agency in recognition of collaborative digital work. My involvement included contributing as a member of the design team across these initiatives.
      </p>
      <div class="awards-block">
        {
          agencyAwards.map((award, index) => (
            <button
              class="award-item"
              data-award-index={index}
              data-category="agency"
              type="button"
            >
              <div class="award-info">
                <div class="award-header">
                  <span class="award-emoji">{getAwardEmoji(award.title)}</span>
                  <div>
                    <h5>{award.date}</h5>
                    <h3>{award.title}</h3>
                  </div>
                </div>
                <p>{award.description}</p>

                <div class="link-btn">
                  <span class="view-project">
                    {award.linkUrl ? "View Awards" : "Read More"}
                  </span>
                  <span class="icon-circle">
                    <img
                      src={arrow.src}
                      width="18"
                      height="18"
                      alt=""
                      aria-hidden="true"
                    />
                  </span>
                </div>
              </div>
            </button>
          ))
        }
      </div>

      <!-- Team Projects -->
      <h2 class="flower-heading">Team Projects & Performance</h2>
      <p class="section-description">
        Recognition for collaborative achievements and team performance on
        high-impact projects.
      </p>
      <div class="awards-block">
        {
          teamProjects.map((award, index) => (
            <div class="award-item award-item-static">
              <div class="award-info">
                <div class="award-header">
                  <span class="award-emoji">{getAwardEmoji(award.title)}</span>
                  <div>
                    <h5>{award.date}</h5>
                    <h3>{award.title}</h3>
                  </div>
                </div>
                <p>{award.description}</p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Award Popup Modal -->
      <div class="award-popup" id="award-popup" aria-hidden="true">
        <div class="popup-overlay"></div>
        <div class="popup-content">
          <button class="popup-close" aria-label="Close popup">
            <img
              src={close.src}
              width="24"
              height="24"
              alt=""
              aria-hidden="true"
            />
          </button>
          <div class="popup-body">
            <h5 id="popup-date"></h5>
            <h3 id="popup-title"></h3>
            <p id="popup-content"></p>
          </div>
        </div>
      </div>

      <CTA />
    </div>
  </div>
</Layout>

<style>
  /* ===== GRADIENT HEADER ===== */
  .awards-page-wrapper {
    position: relative;
  }

  .gradient-header {
    background: linear-gradient(
      180deg,
      var(--amaranth) 0%,
      var(--amaranth) 60%,
      rgba(137, 4, 61, 0.8) 80%,
      rgba(137, 4, 61, 0) 100%
    );
    padding: 20px 18px 60px 18px;
    margin: 0 -18px 60px -18px;
  }

  /* White nav links and logo on awards page */
  .gradient-header .navbar .desktop-links .link,
  .gradient-header .navbar a.link {
    color: white !important;
  }

  .gradient-header .navbar .desktop-links .link:hover,
  .gradient-header .navbar a.link:hover {
    color: var(--platinum) !important;
  }

  .gradient-header .navbar .logo img {
    filter: brightness(0) invert(1) !important;
  }

  .gradient-header .navbar .hamburger-menu {
    background-color: rgba(255, 255, 255, 0.2);
  }

  .gradient-header .navbar .hamburger-menu .icon {
    filter: brightness(0) invert(1);
  }

  /* Mobile nav links - keep dark since mobile menu has its own background */
  .gradient-header .navbar #mobile-nav-links .link {
    color: var(--ink-black) !important;
  }

  .gradient-header .innerpage-masthead {
    background: transparent;
    padding: 30px 0;
    margin-bottom: 0;
  }

  .gradient-header .innerpage-masthead h1 {
    color: white;
  }

  @media (min-width: 768px) {
    .gradient-header {
      padding: 30px 18px 100px 18px;
    }

    .gradient-header .innerpage-masthead {
      padding: 50px 0;
    }
  }

  /* ===== AWARD EMOJI & HEADER ===== */
  .award-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .award-emoji {
    font-size: 32px;
    line-height: 1;
    align-self: flex-start;
  }

  .award-header > div {
    width: 100%;
  }

  .award-header h5,
  .award-header h3 {
    margin: 0;
  }

  .award-header h5 {
    margin-bottom: 8px;
  }

  .icon-circle {
    background-color: var(--berry-crush);
    width: 35px;
    height: 35px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 100px;
  }

  .link-btn {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .awards-block:not(:last-of-type) {
    padding-bottom: 60px; /* even smaller on small phones */
  }

  .award-item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background-color: #fff;
    padding: 18px;
    border-radius: 30px;
    border: solid 1px var(--dust-gray);
    cursor: pointer;
    text-align: left;
    width: 100%;
    font-family: inherit;
    height: 100%;
  }

  .award-item-static {
    cursor: default;
    padding: 18px;
    background-color: #fff;
    border-radius: 30px;
    display: flex;
    flex-direction: column;
    text-align: left;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
  }

  .award-item-static:hover {
    box-shadow: none;
    transform: none;
  }

  @media (min-width: 768px) {
    .award-item-static {
      padding: 25px;
    }
  }

  .section-description {
    color: var(--ink-black);
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 30px;
    margin-top: 0;
  }

  @media (min-width: 768px) {
    .section-description {
      font-size: 18px;
      margin-bottom: 40px;
    }
  }

  .award-info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    height: 100%;
  }

  .award-info h5,
  .award-info h3,
  .award-info p {
    margin: 0;
  }

  .award-info h5 {
    margin-bottom: 8px;
  }

  .award-info p {
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .link-btn {
    margin-top: auto;
  }

  .link-btn span {
    font-family: "Stack Sans Text";
    text-transform: uppercase;
    color: var(--berry-crush);
    font-size: 20px;
    font-weight: 700;
  }

  .award-item:hover .link-btn span {
    color: var(--navy-blue);
  }

  .awards-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px !important;
    align-items: stretch;
  }

  .award-item,
  .award-item-static {
    margin-bottom: 0;
    min-width: 0;
  }

  /* Ensure spacing between grid items */
  .awards-block > * {
    margin: 0;
  }

  .innerpage-masthead h1 {
    margin: 0px;
    color: white;
  }

  .innerpage-masthead {
    background: var(--gradient-accent);
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-radius: 30px;
    margin-bottom: 60px;
  }

  @media (min-width: 768px) {
    .awards-block {
      grid-template-columns: repeat(2, 1fr);
    }

    .award-item:not(.award-item-static):hover {
      box-shadow: 0px 0px 20px #0e171b29;
      transform: translateY(-2px);
    }

    .award-item:not(.award-item-static):hover .link-btn a {
      color: var(--navy-blue);
    }

    .award-item:not(.award-item-static):hover .link-btn .icon-circle {
      background-color: var(--navy-blue);
    }

    .award-item:not(.award-item-static) {
      transition:
        background-color 0.25s ease,
        box-shadow 0.25s ease,
        transform 0.25s ease;
    }

    .awards-block:not(:last-of-type) {
      padding-bottom: 75px;
    }
  }

  @media (min-width: 1280px) {
    .awards-block {
      grid-template-columns: repeat(3, 1fr);
    }

    .award-item p {
      margin: 10px 0;
    }

    .award-item {
      padding: 25px;
    }

    .awards-block:not(:last-of-type) {
      padding-bottom: 100px;
    }

    .innerpage-masthead {
      padding: 100px 40px 40px 40px;
      margin-bottom: 100px;
    }
  }

  /* ===== POPUP MODAL ===== */
  .award-popup {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 24px;
  }

  .award-popup.active {
    display: flex;
  }

  .popup-overlay {
    position: absolute;
    inset: 0;
    background: rgba(14, 23, 27, 0.85);
    backdrop-filter: blur(4px);
  }

  .popup-content {
    position: relative;
    background: white;
    border-radius: 30px;
    padding: 40px 30px;
    max-width: 600px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    z-index: 1;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .popup-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background-color 0.2s ease;
  }

  .popup-close:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .popup-close img {
    filter: brightness(0) saturate(100%) invert(0%) sepia(0%) saturate(0%)
      hue-rotate(0deg) brightness(0%) contrast(100%);
  }

  .popup-body h5 {
    color: var(--berry-crush);
    font-size: 16px;
    margin-bottom: 12px;
    font-weight: 600;
  }

  .popup-body h3 {
    color: var(--ink-black);
    font-size: 24px;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .popup-body p {
    color: var(--ink-black);
    font-size: 16px;
    line-height: 1.6;
    white-space: pre-wrap;
  }

  @media (min-width: 768px) {
    .popup-content {
      padding: 50px 40px;
      max-width: 700px;
    }

    .popup-body h3 {
      font-size: 28px;
    }

    .popup-body p {
      font-size: 18px;
    }
  }

  body.popup-open {
    overflow: hidden;
  }
</style>

<script define:vars={{ agencyAwards, teamProjects, internalRecognition }}>
  const allAwards = [...agencyAwards, ...teamProjects, ...internalRecognition];

  const awardItems = document.querySelectorAll(".award-item");
  const popup = document.getElementById("award-popup");
  const popupClose = document.querySelector(".popup-close");
  const popupOverlay = document.querySelector(".popup-overlay");
  const popupDate = document.getElementById("popup-date");
  const popupTitle = document.getElementById("popup-title");
  const popupContent = document.getElementById("popup-content");

  function openPopup(award) {
    if (award.linkUrl) {
      // If award has a linkUrl, navigate to it
      window.open(award.linkUrl, "_blank", "noopener,noreferrer");
      return;
    }

    if (award.popupContent) {
      // Show popup with content
      popupDate.textContent = award.date;
      popupTitle.textContent = award.title;
      popupContent.textContent = award.popupContent;
      popup.classList.add("active");
      popup.setAttribute("aria-hidden", "false");
      document.body.classList.add("popup-open");
    }
  }

  function closePopup() {
    popup.classList.remove("active");
    popup.setAttribute("aria-hidden", "true");
    document.body.classList.remove("popup-open");
  }

  awardItems.forEach((item) => {
    // Skip static items (Team Projects)
    if (item.classList.contains("award-item-static")) {
      return;
    }

    item.addEventListener("click", () => {
      const category = item.getAttribute("data-category");
      const awardIndex = parseInt(item.getAttribute("data-award-index") || "0");

      let award;
      if (category === "agency") {
        award = allAwards[awardIndex];
      } else {
        award =
          allAwards[agencyAwards.length + teamProjects.length + awardIndex];
      }

      openPopup(award);
    });
  });

  popupClose?.addEventListener("click", closePopup);
  popupOverlay?.addEventListener("click", closePopup);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && popup?.classList.contains("active")) {
      closePopup();
    }
  });
</script>

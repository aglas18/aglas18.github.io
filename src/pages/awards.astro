---
import Navbar from "~/components/Navbar.astro";
import CTA from "~/components/CTA.astro";
import Layout from "../layouts/Layout.astro";
import "~/styles/global.css";

import arrow from "~/assets/arrow.svg";
import { awardsList } from "~/content/awards/Awards";

const agencyAwards = awardsList.filter(
  (award) => award.category === "Agency Awards",
);
const teamProjects = awardsList.filter(
  (award) => award.category === "Team Projects",
);
const internalRecognition = awardsList.filter(
  (award) => award.category === "Internal Recognition",
);
---

<Layout>
  <div class="main-wrapper">
    <Navbar />

    <div class="innerpage-masthead">
      <h1>Awards</h1>
    </div>

    <!-- Agency Awards -->
    <h2 class="flower-heading">Agency Awards</h2>
    <div class="awards-block">
      {
        agencyAwards.map((award) => (
          <a href="#" class="award-item">
            <div class="award-info">
              <h5>{award.date}</h5>
              <h3>{award.title}</h3>
              <p>{award.description}</p>

              <div class="link-btn">
                <span class="view-project">Read More</span>
                <span class="icon-circle">
                  <img
                    src={arrow.src}
                    width="18"
                    height="18"
                    alt=""
                    aria-hidden="true"
                  />
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <!-- Team Projects -->
    <h2 class="flower-heading">Team Projects & Performance</h2>
    <div class="awards-block">
      {
        teamProjects.map((award) => (
          <a href="#" class="award-item">
            <div class="award-info">
              <h5>{award.date}</h5>
              <h3>{award.title}</h3>
              <p>{award.description}</p>

              <div class="link-btn">
                <span class="view-project">Read More</span>
                <span class="icon-circle">
                  <img
                    src={arrow.src}
                    width="18"
                    height="18"
                    alt=""
                    aria-hidden="true"
                  />
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <!-- Internal Recognition -->
    <h2 class="flower-heading">Internal Recognition & Peer Awards</h2>
    <div class="awards-block">
      {
        internalRecognition.map((award) => (
          <a href="#" class="award-item">
            <div class="award-info">
              <h5>{award.date}</h5>
              <h3>{award.title}</h3>
              <p>{award.description}</p>

              <div class="link-btn">
                <span class="view-project">Read More</span>
                <span class="icon-circle">
                  <img
                    src={arrow.src}
                    width="18"
                    height="18"
                    alt=""
                    aria-hidden="true"
                  />
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <CTA />
  </div>
</Layout>

<style>
  .icon-circle {
    background-color: var(--berry-crush);
    width: 35px;
    height: 35px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 100px;
  }

  .link-btn {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .awards-block:not(:last-of-type) {
    padding-bottom: 60px; /* even smaller on small phones */
  }

  .award-item {
    display: block;
    text-decoration: none;
    color: inherit;
    background-color: #fff;
    padding: 18px;
    border-radius: 30px;
  }

  .link-btn span {
    font-family: "Stack Sans Text";
    text-transform: uppercase;
    color: var(--berry-crush);
    font-size: 20px;
    font-weight: 700;
  }

  .award-item:hover .link-btn span {
    color: var(--navy-blue);
  }

  .awards-block {
    display: grid;
    gap: 30px;
  }

  .innerpage-masthead h1 {
    margin: 0px;
    color: white;
  }

  .innerpage-masthead {
    background: var(--gradient-accent);
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-radius: 30px;
    margin-bottom: 60px;
  }

  @media (min-width: 768px) {
    .awards-block {
      grid-template-columns: repeat(2, 1fr);
    }

    .award-item:hover {
      box-shadow: 0px 0px 20px #0e171b29;
      transform: translateY(-2px);
    }

    .award-item:hover .link-btn a {
      color: var(--navy-blue);
    }

    .award-item:hover .link-btn .icon-circle {
      background-color: var(--navy-blue);
    }

    .award-item {
      transition:
        background-color 0.25s ease,
        box-shadow 0.25s ease,
        transform 0.25s ease;
    }

    .awards-block:not(:last-of-type) {
      padding-bottom: 75px;
    }
  }

  @media (min-width: 1280px) {
    .awards-block {
      grid-template-columns: repeat(3, 1fr);
    }

    .award-item p {
      margin: 10px 0;
    }

    .award-item {
      padding: 25px;
    }

    .awards-block:not(:last-of-type) {
      padding-bottom: 100px;
    }

    .innerpage-masthead {
      padding: 100px 40px 40px 40px;
      margin-bottom: 100px;
    }
  }
</style>

---
import Navbar from "~/components/Navbar.astro";
import Footer from "~/components/Footer.astro";
import "~/styles/global.css";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="main-wrapper">
    <Navbar />

    <section class="contact">
      <div class="contact-intro">
        <h1 class="flower-heading">Let's Work Together</h1>
        <p>
          Have a project in mind, a question, or just want to say hi? Fill out
          the form below and I'll get back to you.
        </p>
      </div>

      <form
        class="contact-form"
        action="https://getform.io/f/bolqqmja"
        method="post"
      >
        <div class="form-group">
          <input id="name" name="name" type="text" placeholder=" " required />
          <label for="name">Name</label>
        </div>

        <div class="form-group">
          <input
            id="email"
            name="email"
            type="email"
            placeholder=" "
            required
          />
          <label for="email">Email</label>
        </div>

        <div class="form-group">
          <textarea
            id="message"
            name="message"
            rows="5"
            placeholder=" "
            required></textarea>
          <label for="message">Message</label>
        </div>

        <button type="submit" class="submit-btn">Send Message</button>
      </form>
    </section>

    <Footer />
  </div>
</Layout>

<style>
  .contact {
    max-width: 900px;
    margin: 40px auto 80px;
    padding: 40px 24px 48px;
    display: flex;
    flex-direction: column;
    gap: 40px;
    background-color: #ffffff;
    border-radius: 30px;
    position: relative;
    box-shadow: 0 18px 45px rgba(14, 23, 27, 0.16);
    background-image:
      radial-gradient(circle at top left, rgba(137, 4, 61, 0.14), rgba(137, 4, 61, 0) 60%),
      radial-gradient(circle at bottom right, rgba(34, 56, 67, 0.14), rgba(34, 56, 67, 0) 55%);
    overflow: hidden;
  }

  .contact::before {
    content: "";
    position: absolute;
    top: -20px;
    right: 18px;
    width: 90px;
    height: 90px;
    background: var(--flower-stroke) no-repeat center / contain;
    opacity: 0.18;
    pointer-events: none;
  }

  .contact-intro h1 {
    text-align: center;
    margin-top: 0px;
    margin-bottom: 12px;
  }

  .contact-intro p {
    text-align: center;
    max-width: 600px;
    margin-bottom: 0;
  }

  .contact-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: stretch;
  }

  .form-group {
    position: relative;
    width: 100%;
  }

  input,
  textarea {
    width: 100%;
    padding: 16px 16px;
    border-radius: 12px;
    border: 1px solid var(--ink-black);
    font-family: inherit;
    font-size: 16px;
    background: transparent;
    font-family: var(--font-body);
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--berry-crush);
    box-shadow: 0 0 0 2px rgba(170, 68, 101, 0.25);
  }

  /* Floating labels */
  label {
    position: absolute;
    top: 50%;
    left: 16px;
    transform: translateY(-50%);
    color: var(--dust-gray);
    font-size: 16px;
    pointer-events: none;
    transition: all 0.25s ease;
    font-family: var(--font-body);
  }

  input:focus + label,
  textarea:focus + label,
  input:not(:placeholder-shown) + label,
  textarea:not(:placeholder-shown) + label {
    top: -10px;
    font-size: 12px;
    background-color: var(--platinum);
    padding: 0 6px;
    color: var(--navy-blue);
  }

  .submit-btn {
    margin-top: 10px;
    padding: 14px 26px;
    border-radius: 999px;
    border: none;
    background: var(--gradient-accent);
    color: var(--platinum);
    font-size: 16px;
    cursor: pointer;
    width: fit-content;
    font-family: var(--font-primary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    box-shadow: 0 14px 30px rgba(137, 4, 61, 0.35);
    transition:
      background 0.25s ease,
      transform 0.15s ease,
      box-shadow 0.25s ease;
  }

  .submit-btn:hover {
    background: var(--ink-black);
    box-shadow: 0 10px 24px rgba(14, 23, 27, 0.45);
    transform: translateY(-1px);
  }

  .submit-btn:focus-visible {
    outline: 2px solid var(--berry-crush);
    outline-offset: 2px;
  }

  @media (min-width: 768px) {
    .contact {
      padding: 48px 40px 56px;
      display: grid;
      grid-template-columns: 1.1fr 1.4fr;
      column-gap: 48px;
      align-items: flex-start;
    }

    .contact-intro {
      align-items: flex-start;
    }

    .contact-intro h1,
    .contact-intro p {
      text-align: left;
    }

    .contact-intro p {
      max-width: none;
    }
  }

  @media (min-width: 1024px) {
    .contact {
      max-width: 960px;
      padding: 56px 56px 64px;
    }

    .contact::before {
      top: -30px;
      right: 40px;
      width: 120px;
      height: 120px;
      opacity: 0.22;
    }
  }
</style>

---
import Navbar from "../../components/Navbar.astro";
import CTA from "../../components/CTA.astro";
import "../../../src/styles/global.css";
import arrow from "../../assets/arrow.svg";
import close from "../../assets/close.svg";
import Layout from "../../layouts/Layout.astro";

import type { WorkFile } from "../../pages/work/types";

// -------------------------------
// Dynamic routes
// -------------------------------
export async function getStaticPaths() {
  const allWork = Object.values(
    import.meta.glob("../../content/work/*.md", { eager: true }),
  ) as WorkFile[];

  return allWork.map((work) => ({
    params: { slug: work.frontmatter.slug },
  }));
}

const { slug } = Astro.params;

const allWork = Object.values(
  import.meta.glob("../../content/work/*.md", { eager: true }),
) as WorkFile[];

const project = allWork.find((w) => w.frontmatter.slug === slug);

if (!project) {
  throw new Error(`Project not found: ${slug}`);
}

const { frontmatter } = project;
---

<Layout>
  <div class="main-wrapper">
    <Navbar />

    <!-- Hero Image -->
    <section class="hero">
      <div>
        <h5>{frontmatter.projectType || "Project Type"}</h5>
        <h1>{frontmatter.title}</h1>
      </div>
      <img src={frontmatter.heroImage.src} alt={frontmatter.heroImage.alt} />
    </section>

    <!-- Title & Long Description -->
    <section class="project-info">
      <div class="project-cards">
        <div class="card card-one">
          <h3>About the Project</h3>
          <ul>
            {frontmatter.about.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="card card-two">
          <h3>tOOLS used</h3>
          <ul>
            {frontmatter.tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </div>
      </div>

      <div class="project-description">
        <h2>The Brief</h2>
        <p set:html={frontmatter.longDescription} />
      </div>
    </section>

    <!-- Gallery -->
    <section class="gallery">
      <!-- Row 1 -->
      <div class="row row-1">
        <div class="col col-left">
          <div class="gallery-item">
            <img
              src={frontmatter.gallery[0].src}
              alt={frontmatter.gallery[0].alt}
              class="gallery-image"
              data-index="0"
            />
            <span class="gallery-plus-icon"></span>
          </div>

          <div class="bottom-row">
            <div class="gallery-item">
              <img
                src={frontmatter.gallery[1].src}
                alt={frontmatter.gallery[1].alt}
                class="gallery-image"
                data-index="1"
              />
              <span class="gallery-plus-icon"></span>
            </div>
            <div class="gallery-item">
              <img
                src={frontmatter.gallery[2].src}
                alt={frontmatter.gallery[2].alt}
                class="gallery-image"
                data-index="2"
              />
              <span class="gallery-plus-icon"></span>
            </div>
          </div>
        </div>

        <div class="col col-right">
          <div class="gallery-item">
            <img
              src={frontmatter.gallery[3].src}
              alt={frontmatter.gallery[3].alt}
              class="gallery-image"
              data-index="3"
            />
            <span class="gallery-plus-icon"></span>
          </div>
        </div>
      </div>

      <!-- Row 2 -->
      <div class="row row-2">
        <div class="gallery-item">
          <img
            src={frontmatter.gallery[4].src}
            alt={frontmatter.gallery[4].alt}
            class="gallery-image"
            data-index="4"
          />
          <span class="gallery-plus-icon"></span>
        </div>
        <div class="gallery-item">
          <img
            src={frontmatter.gallery[5].src}
            alt={frontmatter.gallery[5].alt}
            class="gallery-image"
            data-index="5"
          />
          <span class="gallery-plus-icon"></span>
        </div>
      </div>

      <!-- Row 3 -->
      <div class="row row-3">
        <div class="gallery-item">
          <img
            src={frontmatter.gallery[6].src}
            alt={frontmatter.gallery[6].alt}
            class="gallery-image"
            data-index="6"
          />
          <span class="gallery-plus-icon"></span>
        </div>
        <div class="gallery-item">
          <img
            src={frontmatter.gallery[7]?.src}
            alt={frontmatter.gallery[7]?.alt}
            class="gallery-image"
            data-index="7"
          />
          <span class="gallery-plus-icon"></span>
        </div>
        <div class="gallery-item">
          <img
            src={frontmatter.gallery[8]?.src}
            alt={frontmatter.gallery[8]?.alt}
            class="gallery-image"
            data-index="8"
          />
          <span class="gallery-plus-icon"></span>
        </div>
      </div>
    </section>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lightbox-close" aria-label="Close">
        <img
          class="close-icon"
          src={close.src}
          width="24"
          height="24"
          alt=""
          aria-hidden="true"
        />
      </button>

      <button class="lightbox-nav prev" aria-label="Previous image">
        <span class="icon-circle">
          <img
            class="arrow arrow-prev"
            src={arrow.src}
            width="24"
            height="24"
            alt=""
            aria-hidden="true"
          />
        </span>
      </button>

      <figure class="lightbox-content">
        <img id="lightbox-image" src="" alt="" />
        <figcaption id="lightbox-caption"></figcaption>
      </figure>

      <button class="lightbox-nav next" aria-label="Next image">
        <span class="icon-circle">
          <img
            class="arrow arrow-next"
            src={arrow.src}
            width="24"
            height="24"
            alt=""
            aria-hidden="true"
          />
        </span>
      </button>
    </div>

    <CTA />
  </div>

  <style>
    /* ===== HERO ===== */
    .hero {
      display: flex;
      flex-direction: column-reverse;
      gap: 0px;
    }

    .hero img {
      width: 100%;
      border-radius: 20px;
      margin-bottom: 2rem;
    }

    .hero h1 {
      margin-top: 0;
    }

    /* ===== PROJECT INFO ===== */
    .project-info {
      background-color: var(--ink-black);
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding: 40px 24px;
      border-radius: 30px;
    }

    .project-description {
      width: 100%;
    }

    .project-description h2,
    .project-description p {
      color: var(--platinum);
    }

    .project-description h2 {
      margin-bottom: 20px;
    }

    /* ===== CARDS ===== */
    .project-cards {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .card {
      border-radius: 30px;
      padding: 35px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .card ul {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      justify-content: center;
      padding-left: 0;
    }

    .card li {
      list-style: none;
      padding: 10px 20px;
      width: fit-content;
      border-radius: 100px;
    }

    .card-one {
      background-color: var(--platinum);
    }

    .card-one li {
      border: solid 1px var(--navy-blue);
    }

    .card-two {
      border: solid 1px var(--platinum);
    }

    .card-two li {
      background-color: var(--platinum);
    }

    .card-two h3 {
      color: var(--platinum);
    }

    /* ===== GALLERY (mobile stacked) ===== */
    .gallery {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .row-1,
    .row-2,
    .row-3 {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    /* Gallery item wrapper - size-neutral, transparent to layout */
    .gallery-item {
      position: relative;
      display: block;
    }

    .row-1 .gallery-item,
    .row-2 .gallery-item,
    .row-3 .gallery-item {
      width: 100%;
    }

    .row-1 .gallery-item img,
    .row-2 .gallery-item img,
    .row-3 .gallery-item img {
      width: 100%;
      height: auto;
      object-fit: cover;
      border-radius: 15px;
    }

    .col-left,
    .col-right {
      width: 100%;
    }

    .col-left {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .col-left .bottom-row {
      display: flex;
      gap: 0.5rem;
    }

    .col-left .bottom-row .gallery-item {
      width: 50%;
    }

    @media (min-width: 769px) {
      .hero {
        flex-direction: row;
        align-items: flex-end;
        gap: 50px;
      }

      .hero img {
        flex: 1 !important;
        width: 40% !important;
      }

      .project-info {
        flex-direction: row;
        align-items: center;
        padding: 80px 60px;
        gap: 50px;
      }

      .project-cards {
        width: 60%;
      }

      /* Gallery desktop layout */
      .row-1 {
        flex-direction: row;
      }

      .row-1 .col-left {
        width: 50%;
        flex: 1;
      }

      /* .row-1 .col-left .gallery-item:first-child img {
        max-height: 300px;
      } */

      .col-left .bottom-row .gallery-item {
        flex: 1;
        width: 49%;
        height: 100%;
      }

      .col-left .bottom-row .gallery-item img {
        width: 100%;
        height: 100%;
        border-radius: 8px;
      }

      .col-right {
        flex: 1;
      }

      .col-right .gallery-item {
        height: 100%;
      }

      .col-right .gallery-item img {
        width: 100%;
        height: 100%;
        border-radius: 20px;
      }

      .row-2 {
        flex-direction: row;
        height: 585px;
      }

      .row-2 .gallery-item {
        width: 50%;
        height: 100%;
      }

      .row-2 .gallery-item img {
        width: 100%;
        height: 100%;
      }

      .row-3 {
        flex-direction: row;
        height: 430px;
      }

      .row-3 .gallery-item {
        width: 33.3%;
        height: 100%;
      }

      .row-3 .gallery-item img {
        width: 100%;
        height: 100%;
      }
    }

    /* ===== LIGHTBOX ===== */
    .lightbox {
      position: fixed;
      inset: 0;
      background: rgba(14, 23, 27, 0.85);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 24px;
    }

    .lightbox.active {
      display: flex;
    }

    .lightbox-content {
      max-width: 90vw;
      max-height: 85vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .lightbox-content img {
      width: 85vw;
      height: 80vh;
      max-width: 85vw;
      max-height: 80vh;
      object-fit: contain;
      border-radius: 16px;
    }

    .lightbox-content figcaption {
      margin-top: 20px;
      color: var(--platinum);
      font-family:
        "Stack Sans Text",
        system-ui,
        -apple-system,
        sans-serif;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.6;
      max-width: 80vw;
      text-align: center;
      opacity: 0.9;
      letter-spacing: 0.01em;
    }

    @media (min-width: 768px) {
      .lightbox-content figcaption {
        font-size: 18px;
        margin-top: 24px;
      }
    }

    @media (min-width: 1440px) {
      .lightbox-content figcaption {
        font-size: 20px;
        line-height: 1.7;
      }
    }

    .lightbox-close {
      position: absolute;
      top: 20px;
      right: 24px;
      background: none;
      border: none;
      font-size: 2rem;
      color: var(--platinum);
      cursor: pointer;
    }

    .lightbox-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .lightbox-nav.prev {
      left: 24px;
    }

    .lightbox-nav.next {
      right: 24px;
    }

    .icon-circle {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background-color: rgba(14, 23, 27, 0.8);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background-color 0.25s ease;
    }

    .arrow-prev {
      transform: rotate(180deg);
    }

    .arrow-next {
      transform: rotate(0deg);
    }

    .gallery-item img {
      cursor: zoom-in;
    }

    /* Gallery plus icon hover effect */
    .gallery-plus-icon {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 32px;
      height: 32px;
      background: url("/assets/add.svg") no-repeat center / contain;
      filter: brightness(0) invert(1);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.25s ease,
        visibility 0.25s ease;
      z-index: 10;
      pointer-events: none;
    }

    /* Overlay background on hover */
    .gallery-item::before {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(14, 23, 27, 0.7);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.25s ease,
        visibility 0.25s ease;
      border-radius: 15px;
      z-index: 1;
      pointer-events: none;
    }

    /* Match overlay border-radius to image border-radius in different contexts */
    .col-left .bottom-row .gallery-item::before {
      border-radius: 8px;
    }

    @media (min-width: 769px) {
      .col-right .gallery-item::before {
        border-radius: 20px;
      }
    }

    .gallery-item:hover::before {
      opacity: 1;
      visibility: visible;
    }

    .gallery-item:hover .gallery-plus-icon {
      opacity: 1;
      visibility: visible;
    }

    /* Hover feedback */
    .lightbox-nav:hover .icon-circle {
      background-color: var(--navy-blue);
    }

    .lightbox-nav:hover .arrow {
      filter: brightness(0) invert(1);
    }
  </style>

  <script>
    const images = Array.from(document.querySelectorAll(".gallery-image"));
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById("lightbox-image");
    const lightboxCaption = document.getElementById("lightbox-caption");

    const closeBtn = document.querySelector(".lightbox-close");
    const prevBtn = document.querySelector(".lightbox-nav.prev");
    const nextBtn = document.querySelector(".lightbox-nav.next");

    let currentIndex = 0;

    function openLightbox(index) {
      const img = images[index];
      currentIndex = index;

      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightboxCaption.textContent = img.alt || "";

      lightbox.classList.add("active");
      lightbox.setAttribute("aria-hidden", "false");
    }

    function closeLightbox() {
      lightbox.classList.remove("active");
      lightbox.setAttribute("aria-hidden", "true");
    }

    function showNext() {
      currentIndex = (currentIndex + 1) % images.length;
      openLightbox(currentIndex);
    }

    function showPrev() {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      openLightbox(currentIndex);
    }

    images.forEach((img, index) => {
      img.addEventListener("click", () => openLightbox(index));
    });

    closeBtn.addEventListener("click", closeLightbox);
    nextBtn.addEventListener("click", showNext);
    prevBtn.addEventListener("click", showPrev);

    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener("keydown", (e) => {
      if (!lightbox.classList.contains("active")) return;

      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowRight") showNext();
      if (e.key === "ArrowLeft") showPrev();
    });
  </script>
</Layout>

---
import Navbar from "../../components/Navbar.astro";
import CTA from "../../components/CTA.astro";
import "../../../src/styles/global.css";
import arrow from "../../assets/arrow.svg";
import close from "../../assets/close.svg";
import Layout from "../../layouts/Layout.astro";

import type { WorkFile } from "../../pages/work/types";

// -------------------------------
// Dynamic routes
// -------------------------------
export async function getStaticPaths() {
  const allWork = Object.values(
    import.meta.glob("../../content/work/*.md", { eager: true }),
  ) as WorkFile[];

  return allWork.map((work) => ({
    params: { slug: work.frontmatter.slug },
  }));
}

const { slug } = Astro.params;

const allWork = Object.values(
  import.meta.glob("../../content/work/*.md", { eager: true }),
) as WorkFile[];

const project = allWork.find((w) => w.frontmatter.slug === slug);

if (!project) {
  throw new Error(`Project not found: ${slug}`);
}

const { frontmatter } = project;

// Convert old single figmaEmbed into new prototypes array if it exists
const prototypes =
  frontmatter.prototypes ||
  (frontmatter.figmaEmbed
    ? [{ label: "Web Prototype", url: frontmatter.figmaEmbed }]
    : []);
---

<Layout>
  <div class="main-wrapper">
    <Navbar />

    <!-- Hero Image -->
    <section class="hero">
      <div>
        <h5>{frontmatter.projectType || "Project Type"}</h5>
        <h1>{frontmatter.title}</h1>
      </div>
      <img src={frontmatter.heroImage.src} alt={frontmatter.heroImage.alt} />
    </section>

    <!-- Title & Long Description -->
    <section class="project-info">
      <div class="project-cards">
        <div class="card card-one">
          <h3>About the Project</h3>
          <ul>
            {frontmatter.about.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="card card-two">
          <h3>Tools used</h3>
          <ul>
            {frontmatter.tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </div>
      </div>

      <div class="project-description">
        <h2>The Brief</h2>
        <p set:html={frontmatter.longDescription} />
      </div>
    </section>

    <!-- Gallery -->
    <section class="gallery">
      <!-- ... Keep your existing gallery layout unchanged ... -->
    </section>

    <!-- Figma Prototypes (Customizable Tabs) -->
    {
      prototypes.length > 0 && (
        <section class="figma-embed">
          <h2>Web Prototypes</h2>
          <div class="proto-tabs">
            {prototypes.map((proto, index) => (
              <button
                class={`proto-tab ${index === 0 ? "active" : ""}`}
                data-url={proto.url}
              >
                {proto.label}
              </button>
            ))}
          </div>
          <div class="figma-container proto-frame-wrapper">
            <iframe
              id="proto-frame"
              src={prototypes[0].url}
              allowfullscreen
              class="figma-iframe"
              title={`${frontmatter.title} - Figma Prototype`}
              loading="lazy"
            />
          </div>
        </section>
      )
    }

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox" aria-hidden="true">
      <!-- ... Keep your existing lightbox markup unchanged ... -->
    </div>

    <CTA />
  </div>

  <style>
    /* ===== Existing CSS ... KEEP ALL your existing styles above ... ===== */

    /* ===== PROTOTYPE TABS ===== */
    .proto-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 1.5rem;
    }

    .proto-tab {
      padding: 0.5rem 1rem;
      border-radius: 12px;
      border: 1px solid var(--navy-blue);
      background: var(--platinum);
      color: var(--ink-black);
      font-weight: 500;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .proto-tab.active {
      background: var(--navy-blue);
      color: var(--platinum);
      border-color: var(--navy-blue);
    }
  </style>

  <script>
    // Prototype tabs
    const protoSection = document.querySelector(".figma-embed");
    if (protoSection) {
      const tabs = protoSection.querySelectorAll(".proto-tab");
      const frame = protoSection.querySelector("#proto-frame");

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((t) => t.classList.remove("active"));
          tab.classList.add("active");
          frame.src = tab.dataset.url;
        });
      });
    }

    // ===== Lightbox script remains unchanged =====
    const images = Array.from(document.querySelectorAll(".gallery-image"));
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById("lightbox-image");
    const lightboxCaption = document.getElementById("lightbox-caption");

    const closeBtn = document.querySelector(".lightbox-close");
    const prevBtn = document.querySelector(".lightbox-nav.prev");
    const nextBtn = document.querySelector(".lightbox-nav.next");

    let currentIndex = 0;

    function openLightbox(index) {
      const img = images[index];
      currentIndex = index;

      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightboxCaption.textContent = img.alt || "";

      lightbox.classList.add("active");
      lightbox.setAttribute("aria-hidden", "false");
    }

    function closeLightbox() {
      lightbox.classList.remove("active");
      lightbox.setAttribute("aria-hidden", "true");
    }

    function showNext() {
      currentIndex = (currentIndex + 1) % images.length;
      openLightbox(currentIndex);
    }

    function showPrev() {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      openLightbox(currentIndex);
    }

    images.forEach((img, index) => {
      img.addEventListener("click", () => openLightbox(index));
    });

    closeBtn.addEventListener("click", closeLightbox);
    nextBtn.addEventListener("click", showNext);
    prevBtn.addEventListener("click", showPrev);

    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener("keydown", (e) => {
      if (!lightbox.classList.contains("active")) return;

      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowRight") showNext();
      if (e.key === "ArrowLeft") showPrev();
    });
  </script>
</Layout>

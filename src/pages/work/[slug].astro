---
import Navbar from "../../components/Navbar.astro";
import CTA from "../../components/CTA.astro";
import "../../../src/styles/global.css";

import type { WorkFile } from "../../pages/work/types";

// -------------------------------
// Dynamic routes
// -------------------------------
export async function getStaticPaths() {
  const allWork = Object.values(
    import.meta.glob("../../content/work/*.md", { eager: true })
  ) as WorkFile[];

  return allWork.map((work) => ({
    params: { slug: work.frontmatter.slug },
  }));
}

const { slug } = Astro.params;

const allWork = Object.values(
  import.meta.glob("../../content/work/*.md", { eager: true })
) as WorkFile[];

const project = allWork.find((w) => w.frontmatter.slug === slug);

if (!project) {
  throw new Error(`Project not found: ${slug}`);
}

const { frontmatter } = project;
---

<div class="main-wrapper">
  <Navbar />

  <!-- Hero Image -->
  <section class="hero">
    <div>
      <h5>{frontmatter.projectType}</h5>
      <h1>{frontmatter.title}</h1>
    </div>
    <img src={frontmatter.heroImage.src} alt={frontmatter.heroImage.alt} />
  </section>

  <!-- Title & Long Description -->
  <section class="project-info">
    <div class="project-cards">
      <div class="card card-one">
        <h3>About the Project</h3>
        <ul>
          {frontmatter.about.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="card card-two">
        <h3>tOOLS used</h3>
        <ul>
          {frontmatter.tools.map((tool) => <li>{tool}</li>)}
        </ul>
      </div>
    </div>

    <div class="project-description">
      <h2>The Brief</h2>
      <p>{frontmatter.longDescription}</p>
    </div>
  </section>

  <!-- Gallery -->
  <section class="gallery">
    <!-- Row 1 -->
    <div class="row row-1">
      <div class="col col-left">
        <img
          src={frontmatter.gallery[0].src}
          alt={frontmatter.gallery[0].alt}
        />
        <div class="bottom-row">
          <img
            src={frontmatter.gallery[1].src}
            alt={frontmatter.gallery[1].alt}
          />
          <img
            src={frontmatter.gallery[2].src}
            alt={frontmatter.gallery[2].alt}
          />
        </div>
      </div>
      <div class="col col-right">
        <img
          src={frontmatter.gallery[3].src}
          alt={frontmatter.gallery[3].alt}
        />
      </div>
    </div>

    <!-- Row 2 -->
    <div class="row row-2">
      <img src={frontmatter.gallery[4].src} alt={frontmatter.gallery[4].alt} />
      <img src={frontmatter.gallery[5].src} alt={frontmatter.gallery[5].alt} />
    </div>

    <!-- Row 3 -->
    <div class="row row-3">
      <img src={frontmatter.gallery[6].src} alt={frontmatter.gallery[6].alt} />
      <img
        src={frontmatter.gallery[7]?.src}
        alt={frontmatter.gallery[7]?.alt}
      />
      <img
        src={frontmatter.gallery[8]?.src}
        alt={frontmatter.gallery[8]?.alt}
      />
    </div>
  </section>
  <CTA />
</div>

<style>
  /* ===== HERO ===== */
  .hero {
    display: flex;
    flex-direction: column-reverse;
    gap: 0px;
  }

  .hero img {
    width: 100%;
    border-radius: 20px;
    margin-bottom: 2rem;
  }

  .hero h1 {
    margin-top: 0;
  }

  /* ===== PROJECT INFO ===== */
  .project-info {
    background-color: var(--ink-black);
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 40px 24px;
    border-radius: 30px;
  }

  .project-description {
    width: 100%;
  }

  .project-description h2,
  .project-description p {
    color: var(--platinum);
  }

  .project-description h2 {
    margin-bottom: 20px;
  }

  /* ===== CARDS ===== */
  .project-cards {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .card {
    border-radius: 30px;
    padding: 35px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    justify-content: center;
    padding-left: 0;
  }

  .card li {
    list-style: none;
    padding: 10px 20px;
    width: fit-content;
    border-radius: 100px;
  }

  .card-one {
    background-color: var(--platinum);
  }

  .card-one li {
    border: solid 1px var(--navy-blue);
  }

  .card-two {
    border: solid 1px var(--platinum);
  }

  .card-two li {
    background-color: var(--platinum);
  }

  .card-two h3 {
    color: var(--platinum);
  }

  /* ===== GALLERY (mobile stacked) ===== */
  .gallery {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .row-1,
  .row-2,
  .row-3 {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .row-1 img,
  .row-2 img,
  .row-3 img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 15px;
  }

  .col-left,
  .col-right {
    width: 100%;
  }

  .col-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .col-left .bottom-row {
    display: flex;
    gap: 0.5rem;
  }

  .col-left .bottom-row img {
    width: 50%;
  }

  @media (min-width: 769px) {
    .hero {
      flex-direction: row;
      align-items: flex-end;
    }

    .hero img {
      flex: 1 !important;
      width: 40% !important;
    }

    .project-info {
      flex-direction: row;
      align-items: center;
      padding: 80px 60px;
      gap: 50px;
    }

    .project-cards {
      width: 35%;
    }

    /* Gallery desktop layout */
    .row-1 {
      flex-direction: row;
    }

    .row-1 .col-left {
      width: 50%;
      flex: 1;
    }

    .col-left img {
      max-height: 300px;
    }

    .col-left .bottom-row img {
      flex: 1;
      width: 49%;
      height: 100%;
      border-radius: 8px;
    }

    .col-right {
      flex: 1;
    }

    .col-right img {
      height: 100%;
      border-radius: 20px;
    }

    .row-2 {
      flex-direction: row;
      height: 585px;
    }

    .row-2 img {
      width: 50%;
      height: 100%;
    }

    .row-3 {
      flex-direction: row;
      height: 430px;
    }

    .row-3 img {
      width: 33.3%;
      height: 100%;
    }
  }
</style>

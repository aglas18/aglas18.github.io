---
import Navbar from "../../components/Navbar.astro";
import CTA from "../../components/CTA.astro";
import "../../../src/styles/global.css";
import arrow from "../../assets/arrow.svg";
import close from "../../assets/close.svg";
import Layout from "../../layouts/Layout.astro";
import ProjectDefault from "../../components/work/ProjectDefault.astro";
import ProjectCaseStudy from "../../components/work/ProjectCaseStudy.astro";

import type { WorkFile } from "../../pages/work/types";

export async function getStaticPaths() {
  const allWork = Object.values(
    import.meta.glob("../../content/work/*.md", { eager: true }),
  ) as WorkFile[];

  return allWork.map((work) => ({
    params: { slug: work.frontmatter.slug },
  }));
}

const { slug } = Astro.params;

const allWork = Object.values(
  import.meta.glob("../../content/work/*.md", { eager: true }),
) as WorkFile[];

const project = allWork.find((w) => w.frontmatter.slug === slug);

if (!project) {
  throw new Error(`Project not found: ${slug}`);
}

const { frontmatter } = project;
const layout =
  frontmatter.pageTemplate === "caseStudy" ? "caseStudy" : "default";
---

<Layout>
  <div class="main-wrapper">
    <Navbar />

    {
      layout === "caseStudy" ? (
        <ProjectCaseStudy frontmatter={frontmatter} />
      ) : (
        <ProjectDefault frontmatter={frontmatter} />
      )
    }

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lightbox-close" aria-label="Close">
        <img
          class="close-icon"
          src={close.src}
          width="24"
          height="24"
          alt=""
          aria-hidden="true"
        />
      </button>

      <button class="lightbox-nav prev" aria-label="Previous image">
        <span class="icon-circle">
          <img
            class="arrow arrow-prev"
            src={arrow.src}
            width="24"
            height="24"
            alt=""
            aria-hidden="true"
          />
        </span>
      </button>

      <figure class="lightbox-content">
        <img id="lightbox-image" src="" alt="" />
        <figcaption id="lightbox-caption"></figcaption>
      </figure>

      <button class="lightbox-nav next" aria-label="Next image">
        <span class="icon-circle">
          <img
            class="arrow arrow-next"
            src={arrow.src}
            width="24"
            height="24"
            alt=""
            aria-hidden="true"
          />
        </span>
      </button>
    </div>

    <CTA />
  </div>

  <style>
    .close-icon {
      filter: brightness(0) saturate(100%) invert(100%) sepia(1%) saturate(0%)
        hue-rotate(352deg) brightness(106%) contrast(100%);
    }

    .lightbox {
      position: fixed;
      inset: 0;
      background: rgba(14, 23, 27, 0.85);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 24px;
    }

    .lightbox.active {
      display: flex;
    }

    .lightbox-content {
      max-width: 90vw;
      max-height: 85vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .lightbox-content img {
      width: 85vw;
      height: 80vh;
      max-width: 85vw;
      max-height: 80vh;
      object-fit: contain;
      border-radius: 16px;
    }

    .lightbox-content figcaption {
      margin-top: 20px;
      color: var(--platinum);
      font-family:
        "Stack Sans Text",
        system-ui,
        -apple-system,
        sans-serif;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.6;
      max-width: 80vw;
      text-align: center;
      opacity: 0.9;
      letter-spacing: 0.01em;
    }

    @media (min-width: 768px) {
      .lightbox-content figcaption {
        font-size: 18px;
        margin-top: 24px;
      }
    }

    @media (min-width: 1440px) {
      .lightbox-content figcaption {
        font-size: 20px;
        line-height: 1.7;
      }

      .cs-row:not(:has(.cs-row-stack-bottom)) .cs-row-frame img {
        min-height: 550px;
      }
    }

    .lightbox-close {
      position: absolute;
      top: 20px;
      right: 24px;
      background: none;
      border: none;
      font-size: 2rem;
      color: var(--platinum);
      cursor: pointer;
    }

    .lightbox-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .lightbox-nav.prev {
      left: 24px;
    }

    .lightbox-nav.next {
      right: 24px;
    }

    .icon-circle {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background-color: rgba(14, 23, 27, 0.8);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background-color 0.25s ease;
    }

    .arrow-prev {
      transform: rotate(180deg);
    }

    .arrow-next {
      transform: rotate(0deg);
    }

    .lightbox-nav:hover .icon-circle {
      background-color: var(--navy-blue);
    }

    .lightbox-nav:hover .arrow {
      filter: brightness(0) invert(1);
    }
  </style>

  <script>
    const images = Array.from(
      document.querySelectorAll<HTMLImageElement>(".gallery-image"),
    );
    const lightbox = document.getElementById("lightbox") as HTMLElement | null;
    const lightboxImg = document.getElementById(
      "lightbox-image",
    ) as HTMLImageElement | null;
    const lightboxCaption = document.getElementById(
      "lightbox-caption",
    ) as HTMLElement | null;

    const closeBtn = document.querySelector<HTMLElement>(".lightbox-close");
    const prevBtn = document.querySelector<HTMLElement>(".lightbox-nav.prev");
    const nextBtn = document.querySelector<HTMLElement>(".lightbox-nav.next");

    let currentIndex = 0;

    function openLightbox(index: number) {
      if (!lightbox || !lightboxImg || !lightboxCaption) return;
      if (!images.length) return;
      const img = images[index];
      if (!img) return;
      currentIndex = index;

      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightboxCaption.textContent = img.alt || "";

      lightbox.classList.add("active");
      lightbox.setAttribute("aria-hidden", "false");
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove("active");
      lightbox.setAttribute("aria-hidden", "true");
    }

    function showNext() {
      if (!images.length) return;
      currentIndex = (currentIndex + 1) % images.length;
      openLightbox(currentIndex);
    }

    function showPrev() {
      if (!images.length) return;
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      openLightbox(currentIndex);
    }

    if (lightbox && lightboxImg && lightboxCaption && images.length > 0) {
      images.forEach((img, index) => {
        img.addEventListener("click", () => openLightbox(index));
      });

      closeBtn?.addEventListener("click", closeLightbox);
      nextBtn?.addEventListener("click", showNext);
      prevBtn?.addEventListener("click", showPrev);

      lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener("keydown", (e) => {
        if (!lightbox.classList.contains("active")) return;

        if (e.key === "Escape") closeLightbox();
        if (e.key === "ArrowRight") showNext();
        if (e.key === "ArrowLeft") showPrev();
      });
    }
  </script>
</Layout>

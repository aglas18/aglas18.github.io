---
import Navbar from "../components/Navbar.astro";
import CTA from "../components/CTA.astro";
import "../styles/global.css";
---

<div class="main-wrapper">
  <Navbar />

  <section class="about-hero">
    <div class="left-content">
      <h1>Hi, I'm Adrian!</h1>
      <p>
        A creative designer and problem-solver focused on developing thoughtful
        and visually compelling digital experiences and brands.
      </p>
    </div>
    <div class="right-content">
      <img
        class="profile-pic"
        src="../assets/profile-pic.png"
        width="100%"
        height="100%"
        alt="profile picture"
      />
    </div>
  </section>

  <section class="about-content">
    <div class="about-text">
      <h2>My Background</h2>
      <p>
        I fell in love with graphic design through my art classes in high
        school. I loved drawing and creating, but I ultimately found my passion
        in visual storytelling and using design to solve problems. I enjoy
        digging into the why behind a challenge just as much as crafting the
        final solution, whether that means refining a design system, shaping a
        brand's visual language, or polishing the small details that make an
        experience feel intentional.
      </p>

      <p>
        As a fan of TV shows, books, and video games, storytelling and
        problem-solving sit at the core of my work. I am fascinated by how
        thoughtful design can guide someone, clarify an idea, and make an
        experience feel effortless.
      </p>
    </div>
    <div class="education">
      <h2>Education</h2>
      <div class="education-stuff">
        <p class="item major">
          B.S. in Digital Communications and Creative Arts
        </p>
        <p class="item school">Lebanon Valley College | Graduated 2022</p>
      </div>

      <p>
        My education gave me a strong foundation in visual design, typography,
        color theory, and concept development, while also encouraging
        experimentation and critical thinking. Through studio courses and
        collaborative projects, I learned how to translate ideas into visual
        systems and communicate effectively through design.
      </p>
    </div>
  </section>

  <CTA />
</div>
<style>
  .about-hero {
    padding: 60px 25px 40px;
  }

  .about-hero h1 {
    margin-bottom: 15px;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .about-image img {
    width: 100%;
    border-radius: 20px;
    object-fit: cover;
  }

  .item {
    border-radius: 30px;
    padding: 5px 20px;
    margin: 0px;
    width: fit-content;
  }
  .major {
    background-color: var(--dust-gray);
    color: var(--ink-black) !important;
  }

  .school {
    border: solid 1px var(--platinum);
  }

  .education-stuff {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .education {
    background-color: var(--ink-black);
    padding: 60px;
    border-radius: 30px;
  }

  .education h2,
  .education p {
    color: var(--platinum);
  }

  .about-hero h1,
  .about-hero p {
    color: var(--platinum);
  }

  .about-hero {
    display: flex;
    flex-direction: column;
  }

  .about-hero {
    background-color: var(--amaranth);
    border-radius: 30px;
    padding: 50px !important;
  }

  .profile-pic {
    width: 400px;
    border-radius: 30px;
  }

  /* Tablet */
  @media (min-width: 768px) {
    .about-content {
      flex-direction: row;
      align-items: center;
    }

    .about-text {
      flex: 1;
    }

    .education {
      flex: 1;
    }

    .about-hero {
      flex-direction: row;
      align-items: flex-end;
    }

    .left-content {
      flex: 1;
    }

    .right-content {
      flex: 1;
    }

    .right-content {
      display: flex;
      justify-content: flex-end;
    }
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .about-hero {
      padding: 80px 0px 60px;
    }

    .about-content {
      gap: 60px;
    }
  }
</style>

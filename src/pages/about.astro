---
import Navbar from "../components/Navbar.astro";
import CTA from "../components/CTA.astro";
import "../styles/global.css";
import ProfilePic from "../assets/profile-pic.png";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="main-wrapper">
    <Navbar />

    <section class="about-hero">
      <div class="left-content">
        <h1>Hi, I'm Adrian!</h1>
        <p>
          A Lead Web Designer focused on crafting thoughtful, visually
          compelling digital experiences and brand systems that balance
          storytelling, usability, and detail.
        </p>
      </div>
      <div class="right-content">
        <img
          class="profile-pic"
          src={ProfilePic.src}
          width="100%"
          height="100%"
          alt="profile picture"
        />
      </div>
    </section>

    <section class="about-content">
      <div class="image-wrapper">
        <img
          class="about-me-img"
          src="/assets/images/about/portfolio.png"
          alt="Portfolio Review"
        />
      </div>

      <div class="image-wrapper">
        <img
          class="about-me-img"
          src="/assets/images/about/grad.jpg"
          alt="Graduation Photo"
        />
      </div>

      <div class="education">
        <h2>Education</h2>

        <div class="education-stuff">
          <p class="item major">
            B.S. in Digital Communications and Creative Arts
          </p>
          <p class="item school">Lebanon Valley College 2022 Alumni</p>
        </div>

        <p>
          My passion for design started in high school art classes, where I
          discovered a love for visual storytelling and creative
          problem-solving. That spark led me to study Digital Communications and
          Creative Arts at Lebanon Valley College, graduating in 2022. At LVC, I
          built a foundation in typography, color, composition, and concept
          development, learning how to turn ideas into clear visual systems
          through teamwork and studio projects. Now, I design digital
          experiences that balance storytelling, usability, and attention to
          detail. I’m fascinated by how design shapes clarity and emotion for
          users, drawing inspiration from the storytelling and structure I see
          in games, TV, and books.
        </p>
      </div>
    </section>
    <section class="portfolio-brag">
      <div class="hehe">
        <h2>Yes I built this website!</h2>
        <img
          class="yippe-img"
          src={"/assets/images/about/yippee.png"}
          alt="Hehe"
        />
      </div>
      <p>
        I'm very proud to say that I built this portfolio website myself, using
        Astro, TypeScript, and Tailwind CSS (all frameworks I learned in this
        process). As a web designer, I have learned a lot about development and
        the structure behind websites and how to bring my designs to life.
      </p>
    </section>

    <CTA />
  </div>
</Layout>

<style>
  .about-hero {
    padding: 60px 25px 40px;
    background-color: var(--amaranth);
    border-radius: 30px;
    padding: 50px !important;
    display: flex;
    flex-direction: column;
  }

  .about-hero h1 {
    margin-bottom: 15px;
  }

  .about-hero h1,
  .about-hero p {
    color: var(--platinum);
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .image-wrapper {
    width: 100%;
  }

  .about-me-img {
    width: 100%;
    display: block;
    border-radius: 30px;
    object-fit: cover;
  }

  .item {
    border-radius: 30px;
    padding: 5px 20px;
    margin: 0;
    width: fit-content;
  }

  .major {
    background-color: var(--dust-gray);
    color: var(--ink-black) !important;
  }

  .school {
    border: solid 1px var(--platinum);
  }

  .education-stuff {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .education {
    background-color: var(--ink-black);
    padding: 60px;
    border-radius: 30px;
  }

  .education h2,
  .education p {
    color: var(--platinum);
  }

  .profile-pic {
    width: 100%;
    border-radius: 30px;
  }

  .hehe {
    display: flex;
    flex-direction: row;
    gap: 10px;
  }

  .yippe-img {
    height: 60px;
  }

  .hehe h2 {
    margin-bottom: 10px;
  }

  /* Tablet */
  @media (min-width: 768px) {
    .about-hero {
      flex-direction: row;
      align-items: flex-end;
    }

    .left-content,
    .right-content {
      flex: 1;
    }

    .right-content {
      display: flex;
      justify-content: flex-end;
    }

    /* Adjust these ratios to taste */
    .image-wrapper {
      flex: 0.8;
      display: flex;
    }

    .education {
      flex: 1.4;
    }

    .about-me-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 30px;
    }
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .about-hero {
      padding: 80px 0 60px;
    }

    .profile-pic {
      width: 400px;
    }

    .about-content {
      gap: 40px;
    }

    .about-content {
      flex-direction: row;
      gap: 40px;
      align-items: stretch;
    }
  }
</style>

---
import Navbar from "../components/Navbar.astro";
import CTA from "../components/CTA.astro";
import "../styles/global.css";
import ProfilePic from "../assets/profile-pic.png";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="main-wrapper">
    <Navbar />

    <section class="about-hero">
      <div class="left-content">
        <h1>Hi, I'm Adrian!</h1>
        <p>
          A Lead Web Designer focused on crafting thoughtful, visually
          compelling digital experiences and brand systems that balance
          storytelling, usability, and detail.
        </p>
      </div>
      <div class="right-content">
        <img
          class="profile-pic"
          src={ProfilePic.src}
          width="100%"
          height="100%"
          alt="profile picture"
        />
      </div>
    </section>

    <section class="about-content">
      <div class="about-images">
        <div class="small-images">
          <img
            class="about-me-img small-img-1"
            src={"/assets/images/about/portfolio.png"}
            width="100%"
            height="10%"
            alt="Doodle of My Cats"
          /><img
            class="about-me-img small-img-1"
            src={"/assets/images/about/grad.png"}
            width="100%"
            height="10%"
            alt="Switch Controller and Hot Cocoa and Candle"
          />
        </div>
      </div>
      <div class="education">
        <h2>Education</h2>
        <div class="education-stuff">
          <p class="item major">
            B.S. in Digital Communications and Creative Arts
          </p>
          <p class="item school">Lebanon Valley College | Graduated 2022</p>
        </div>

        <p>
          I first discovered design in high school through art classes, where I
          was drawn to visual storytelling and problem-solving through creative
          work. That interest led me to study Digital Communications and
          Creative Arts at Lebanon Valley College, where I graduated in 2022.
          There, I built a foundation in typography, color, composition, and
          concept development, while learning how to translate ideas into clear,
          cohesive visual systems through collaborative studio projects. Today,
          I focus on designing thoughtful digital experiences that balance
          storytelling, usability, and detail. I’m especially interested in how
          design decisions shape clarity and emotion, and I’m often inspired by
          storytelling in games, TV, and books—particularly how structure and
          pacing influence how people understand and engage with an experience.
        </p>
      </div>
    </section>
    <section class="portfolio-brag">
      <h2>Yes I built this website!</h2>
      <img src={"/assets/images/about/yippe.png"} alt="Portfolio Website" />
      <p>
        I'm very proud to say that I built this portfolio website myself, using
        Astro, TypeScript, and Tailwind CSS (all frameworks I learned in this
        process). As a web designer, I have learned a lot about development and
        the structure behind websites and how to bring my designs to life.
      </p>
    </section>

    <CTA />
  </div>
</Layout>

<style>
  .about-hero {
    padding: 60px 25px 40px;
  }

  .about-hero h1 {
    margin-bottom: 15px;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .about-image img {
    width: 100%;
    border-radius: 20px;
    object-fit: cover;
  }

  .item {
    border-radius: 30px;
    padding: 5px 20px;
    margin: 0px;
    width: fit-content;
  }
  .major {
    background-color: var(--dust-gray);
    color: var(--ink-black) !important;
  }

  .school {
    border: solid 1px var(--platinum);
  }

  .education-stuff {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .education {
    background-color: var(--ink-black);
    padding: 60px;
    border-radius: 30px;
  }

  .education h2,
  .education p {
    color: var(--platinum);
  }

  .about-hero h1,
  .about-hero p {
    color: var(--platinum);
  }

  .about-hero {
    display: flex;
    flex-direction: column;
  }

  .about-hero {
    background-color: var(--amaranth);
    border-radius: 30px;
    padding: 50px !important;
  }

  .profile-pic {
    width: 400px;
    border-radius: 30px;
  }

  /* Tablet */
  @media (min-width: 768px) {
    .about-content {
      flex-direction: row;
      align-items: center;
    }

    .about-text {
      flex: 1;
    }

    .education {
      flex: 1;
    }

    .about-hero {
      flex-direction: row;
      align-items: flex-end;
    }

    .left-content {
      flex: 1;
    }

    .right-content {
      flex: 1;
    }

    .right-content {
      display: flex;
      justify-content: flex-end;
    }
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .about-hero {
      padding: 80px 0px 60px;
    }

    .about-content {
      gap: 60px;
    }
  }
</style>

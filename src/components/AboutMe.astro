---
import Image1 from "../assets/me-and-clem.png";
import Image2 from "../assets/cats-drawing.png";
import Image3 from "../assets/hobbies.png";
---

<section class="aboutme">
  <div class="about-images">
    <div class="large-image">
      <img
        class="about-me-img"
        src={Image1.src}
        alt="Me and Clementine"
      />
    </div>

    <div class="small-images">
      <img
        class="about-me-img"
        src={Image2.src}
        alt="Doodle of My Cats"
      /><img
        class="about-me-img"
        src={Image3.src}
        alt="Switch Controller and Hot Cocoa and Candle"
      />
    </div>
  </div>
  <div class="about-text">
    <h2>A Little About Me</h2>
    <p>
      Over the past five years, I've worked across branding, web design,
      editorial, and digital marketing, partnering with clients and internal
      teams to create thoughtful, conversion-focused experiences. As a Lead Web
      Designer, I've taken on increasing ownership of projects, supported
      teammates through mentorship and knowledge sharing, and helped improve
      processes that strengthen design quality across the team. In my free time,
      I enjoy hanging out with my cats, gaming, or obsessing over something
      creative! I love what I do because it lets me mix storytelling,
      problem-solving, and a little bit of art into something people actually
      get to use. I'd love to creatively obsess over your next project with you!
      :)
    </p>
    <a class="btn secondary-btn" href="/about">Learn More</a>
  </div>
</section>

<style>
  .about-me-img {
    display: block;
    width: 100%;
    border-radius: 30px;
    object-fit: cover;
    object-position: center;
  }

  .about-images {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .large-image img {
    aspect-ratio: 1 / 1;
  }

  .small-images {
    display: flex;
    flex-direction: row;
    gap: 12px;
  }

  .small-images img {
    flex: 1;
    width: 50%;
    min-width: 0;
    aspect-ratio: 1 / 1;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .aboutme {
    background: var(--dark-gradient);
    color: var(--platinum);
    padding: 30px;
    border-radius: 30px;
    display: flex;
    flex-direction: column;
    gap: 25px;
  }

  .aboutme h2,
  .aboutme p {
    color: var(--platinum);
  }

  .aboutme h2 {
    margin: 0 0 8px;
  }

  .aboutme p {
    margin: 0;
  }

  .about-text .btn {
    margin-top: 14px;
  }

  @media (min-width: 768px) {
    .aboutme {
      flex-direction: row;
      align-items: center;
      margin: 50px 0;
      gap: 30px;
    }

    .about-images {
      width: 50%;
    }

    .about-text {
      width: 50%;
      padding: 0;
    }
  }

  @media (min-width: 1280px) {
    .aboutme {
      padding: 48px 50px;
      gap: 36px;
      align-items: center;
    }

    .about-images {
      width: 50%;
      flex-direction: row;
      align-items: stretch;
      gap: 14px;
    }

    .large-image {
      flex: 1.55;
      min-width: 0;
    }

    .large-image img {
      height: auto;
      object-position: 40% 40%;
    }

    .small-images {
      flex: 0.72;
      width: auto;
      min-width: 0;
      flex-direction: column;
      gap: 14px;
    }

    .small-images img {
      width: 100%;
      flex: 1 1 0;
      min-height: 0;
      height: 0;
      aspect-ratio: auto;
    }

    .about-text {
      width: 50%;
      padding: 0 0 0 8px;
    }
  }
</style>

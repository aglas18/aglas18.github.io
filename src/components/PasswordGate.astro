---
import { createHash } from "node:crypto";

// Used only in `astro dev` (no post-build encryption). Production pages keep
// ciphertext in a separate content.enc file fetched only after unlock.
const sitePassword = import.meta.env.SITE_PASSWORD || "preview";
const devPasswordHash = import.meta.env.DEV
  ? createHash("sha256").update(sitePassword).digest("hex")
  : "";
---

<div id="password-gate" class="password-gate">
  <form id="password-form" class="password-gate__form" autocomplete="off">
    <h1 class="password-gate__title">Password required</h1>
    <p class="password-gate__copy">Enter the site password to continue.</p>
    <label class="password-gate__label" for="site-password">Password</label>
    <input
      id="site-password"
      class="password-gate__input"
      name="password"
      type="password"
      required
      autofocus
    />
    <p id="password-error" class="password-gate__error" hidden>
      Incorrect password. Try again.
    </p>
    <button class="password-gate__button" type="submit">Enter site</button>
  </form>
</div>

<div id="site-content" class="site-content">
  <slot />
</div>

{/* Strip plaintext from the DOM ASAP in `astro dev` (Elements panel). */}
<script is:inline>
  (function () {
    var content = document.getElementById("site-content");
    var meta = document.getElementById("encrypted-meta");
    if (!meta && content && content.innerHTML.trim()) {
      window.__DEV_SITE_HTML__ = content.innerHTML;
      content.innerHTML = "";
    }
  })();
</script>

<script is:inline define:vars={{ devPasswordHash }}>
  (function () {
    var STORAGE_KEY = "site_password";
    var form = document.getElementById("password-form");
    var error = document.getElementById("password-error");
    var input = document.getElementById("site-password");
    var content = document.getElementById("site-content");
    var metaEl = document.getElementById("encrypted-meta");

    function showError() {
      if (error) error.hidden = false;
      if (input) {
        input.value = "";
        input.focus();
      }
    }

    function unlockUi() {
      document.documentElement.classList.add("password-unlocked");
      document.documentElement.classList.remove("password-locked");
    }

    function b64ToBytes(value) {
      var binary = atob(value);
      var bytes = new Uint8Array(binary.length);
      for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
      return bytes;
    }

    function reviveScripts(root) {
      root.querySelectorAll("script").forEach(function (oldScript) {
        var next = document.createElement("script");
        Array.from(oldScript.attributes).forEach(function (attr) {
          next.setAttribute(attr.name, attr.value);
        });
        next.textContent = oldScript.textContent;
        oldScript.replaceWith(next);
      });
    }

    async function sha256Hex(text) {
      var data = new TextEncoder().encode(text);
      var digest = await crypto.subtle.digest("SHA-256", data);
      return Array.from(new Uint8Array(digest))
        .map(function (b) {
          return b.toString(16).padStart(2, "0");
        })
        .join("");
    }

    async function deriveKey(password, salt, iterations) {
      var material = await crypto.subtle.importKey(
        "raw",
        new TextEncoder().encode(password),
        "PBKDF2",
        false,
        ["deriveKey"],
      );
      return crypto.subtle.deriveKey(
        {
          name: "PBKDF2",
          salt: salt,
          iterations: iterations,
          hash: "SHA-256",
        },
        material,
        { name: "AES-GCM", length: 256 },
        false,
        ["decrypt"],
      );
    }

    async function decryptPayload(password, payload) {
      if (!content) return false;
      var key = await deriveKey(
        password,
        b64ToBytes(payload.salt),
        payload.iter || 100000,
      );
      var plainBuffer = await crypto.subtle.decrypt(
        { name: "AES-GCM", iv: b64ToBytes(payload.iv) },
        key,
        b64ToBytes(payload.data),
      );
      content.innerHTML = new TextDecoder().decode(plainBuffer);
      reviveScripts(content);
      return true;
    }

    async function loadEncryptedPayload() {
      if (!metaEl) return null;
      var meta = JSON.parse(metaEl.textContent || "{}");
      if (!meta.src) return null;
      var response = await fetch(meta.src, { cache: "no-store" });
      if (!response.ok) throw new Error("Failed to load encrypted content");
      return response.json();
    }

    async function tryUnlock(password) {
      try {
        if (metaEl) {
          var payload = await loadEncryptedPayload();
          await decryptPayload(password, payload);
        } else if (devPasswordHash) {
          var hash = await sha256Hex(password);
          if (hash !== devPasswordHash) return false;
          if (!content || !window.__DEV_SITE_HTML__) return false;
          content.innerHTML = window.__DEV_SITE_HTML__;
          reviveScripts(content);
        } else {
          return false;
        }
        sessionStorage.setItem(STORAGE_KEY, password);
        unlockUi();
        return true;
      } catch (err) {
        return false;
      }
    }

    var saved = sessionStorage.getItem(STORAGE_KEY);
    if (saved) {
      tryUnlock(saved).then(function (ok) {
        if (!ok) sessionStorage.removeItem(STORAGE_KEY);
      });
    }

    if (form) {
      form.addEventListener("submit", function (event) {
        event.preventDefault();
        var value = input && "value" in input ? String(input.value) : "";
        tryUnlock(value).then(function (ok) {
          if (!ok) showError();
        });
      });
    }
  })();
</script>

<style is:global>
  html.password-locked,
  html.password-locked body {
    height: 100%;
    overflow: hidden;
  }

  html:not(.password-unlocked) #password-gate {
    display: grid;
  }

  html.password-unlocked #password-gate {
    display: none !important;
  }

  html:not(.password-unlocked) #site-content {
    display: none !important;
  }
</style>

<style>
  .password-gate {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 24px;
    background:
      radial-gradient(circle at top, rgba(170, 68, 101, 0.18), transparent 45%),
      linear-gradient(0deg, #0e171b, #223843);
  }

  .password-gate__form {
    width: min(100%, 380px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: #eff1f3;
  }

  .password-gate__title {
    margin: 0;
    font-family: "Facile Sans", system-ui, sans-serif;
    font-size: 34px;
    line-height: 1.1;
    text-transform: uppercase;
    color: #eff1f3;
  }

  .password-gate__copy,
  .password-gate__label,
  .password-gate__error {
    margin: 0;
    font-family: "Stack Sans Text", system-ui, sans-serif;
  }

  .password-gate__copy {
    margin-bottom: 8px;
    font-size: 16px;
    color: #dbd3d8;
  }

  .password-gate__label {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #d8b4a0;
  }

  .password-gate__input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid rgba(239, 241, 243, 0.35);
    border-radius: 0;
    background: rgba(14, 23, 27, 0.45);
    color: #eff1f3;
    font-family: "Stack Sans Text", system-ui, sans-serif;
    font-size: 16px;
    padding: 14px 16px;
  }

  .password-gate__input:focus {
    outline: 2px solid #aa4465;
    outline-offset: 2px;
  }

  .password-gate__error {
    color: #d8b4a0;
    font-size: 14px;
  }

  .password-gate__button {
    margin-top: 8px;
    border: 0;
    background: linear-gradient(45deg, #89043d, #aa4465);
    color: #eff1f3;
    font-family: "Facile Sans", system-ui, sans-serif;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 14px 18px;
    cursor: pointer;
  }

  .password-gate__button:hover {
    opacity: 0.92;
  }
</style>

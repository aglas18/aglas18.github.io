---
import flower from '../assets/flower.svg';
import WorkItem from './WorkItem.astro';
---

<div class="work">
    <h2 class="flower-heading">My Work</h2>
    <WorkItem/>
    </div>
    
</div>

<style>

  .icon-circle {
    background-color: var(--berry-crush);
    width: 35px;
    height: 35px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 100px;
}

.link-btn {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

.project-item {
    background-color: #fff;
    padding: 18px;
    border-radius: 30px;
}

.project-image {
    border-radius:20px;
}

</style>
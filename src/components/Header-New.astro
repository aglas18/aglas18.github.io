---
import Flower from "../assets/flower.svg";
---

<section class="masthead">
  <div class="masthead-inner">
    <div class="header">
      <div class="subheading">adrian glasmyre</div>
      <h1>Creative and Self-Motivated Designer</h1>
      <p>
        Passionate about transforming ideas into engaging digital experiences.
        Specialized in delivering website redesigns and digital assets that
        balance design, UX, and brand storytelling. Detail-oriented and
        collaborative with a strong understanding of how design translates
        across platforms to create seamless, user-centered experiences.
      </p>
      <img
        class="decorative-flower mobile"
        src={Flower.src}
        width="100"
        height="100"
        alt="decorative flower"
      />
    </div>
  </div>
  <div class="header-desktop" aria-hidden="true">
    <img
      class="decorative-flower desktop"
      src={Flower.src}
      width="100"
      height="100"
      alt=""
    />
  </div>
</section>

<style>
  .masthead {
    position: relative;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    overflow: hidden;
    padding-inline: 18px;
  }

  .masthead::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--gradient-accent);
    z-index: 0;
  }

  .masthead::after {
    content: "";
    position: absolute;
    inset: 0;
    background: url("../assets/mobile-header-background.png") center / cover
      no-repeat;
    opacity: 0.3;
    z-index: 1;
    pointer-events: none;
  }

  .masthead-inner {
    position: relative;
    z-index: 2;
  }

  .header {
    position: relative;
    padding: 130px 0 40px;
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .header h1 {
    margin-top: 0px;
  }

  .header h1,
  .header p {
    color: var(--platinum);
    margin-bottom: 0px;
  }

  .header p {
    font-size: 20px;
    line-height: 29px;
  }

  .header .subheading {
    color: var(--dust-gray);
    margin-bottom: 0px;
  }

  .decorative-flower {
    position: absolute !important;
    top: 25px;
    right: 25px;
  }

  .header-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .masthead {
      padding-inline: 40px;
    }
  }

  @media (min-width: 1024px) {
    .masthead {
      padding-inline: 70px;
    }

    .masthead::after {
      background-image: url("../assets/desktop-header-background.png");
      opacity: 0.5;
    }

    .header {
      width: 100%;
      padding-bottom: 48px;
    }

    .header-desktop {
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 2;
    }

    .decorative-flower.mobile {
      display: none;
    }

    .decorative-flower.desktop {
      bottom: 25px;
      right: 25px;
      width: 200px;
      height: 200px;
      top: auto;
    }

    .header .subheading {
      font-weight: bold;
      font-size: 28px;
    }
  }
</style>

---
import Flower from "../assets/flower.svg";
---

<section class="masthead">
  <div class="masthead-inner">
    <div class="header">
      <div class="subheading">adrian glasmyre</div>
      <h1>Brand & Digital Designer</h1>
      <!-- <h4>
        Creating Brand Systems, Digital Experiences, and Conversion-Focused
        Design
      </h4> -->
      <p>
        Lead Web Designer with 5+ years of experience creating brand identities,
        digital experiences, and conversion-focused solutions. Passionate about
        transforming ideas into engaging, user-centered experiences that balance
        design, UX, and brand storytelling. Experienced in leading projects,
        collaborating across teams, and improving design processes to deliver
        impactful work across digital platforms.
      </p>
    </div>
  </div>
  <img
    class="decorative-flower"
    src={Flower.src}
    width="100"
    height="100"
    alt=""
    aria-hidden="true"
  />
</section>

<style>
  /* Same horizontal band as .navbar: full width inside .main-wrapper padding */
  .masthead {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    padding-bottom: 10px;
  }

  .masthead::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #540024, #89043d);
    z-index: 0;
  }

  /* .masthead::after {
    content: "";
    position: absolute;
    inset: 0;
    background: url("../assets/mobile-header-background.png") center / cover
      no-repeat;
    opacity: 0.3;
    z-index: 1;
    pointer-events: none;
  } */

  .masthead-inner {
    position: relative;
    z-index: 2;
  }

  .header {
    position: relative;
    padding: 82px 35px 30px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 83rem;
  }

  .header h1 {
    margin-top: 0px;
  }

  .header h1,
  .header p {
    color: var(--platinum);
    margin-bottom: 0px;
  }

  .header h4 {
    color: var(--dust-gray);
    margin-top: 10px;
  }

  .header p {
    font-size: 20px;
    line-height: 29px;
  }

  .header .subheading {
    color: var(--dust-gray);
    margin-bottom: 0px;
  }

  .decorative-flower {
    position: absolute;
    bottom: 25px;
    right: 25px;
    z-index: 2;
    width: 100px;
    height: 100px;
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    /* .masthead::after {
      background-image: url("../assets/desktop-header-background.png");
      opacity: 0.5;
    } */

    .decorative-flower {
      width: 200px;
      height: 200px;
    }

    .header .subheading {
      font-weight: bold;
      font-size: 28px;
    }
  }
</style>

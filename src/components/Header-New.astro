---
import Flower from "../assets/flower.svg";
---

<section class="masthead">
  <div class="masthead-inner">
    <div class="header">
      <div class="subheading">adrian glasmyre</div>
      <h1>Creative and Self-Motivated Designer</h1>
      <p>
        Passionate about transforming ideas into engaging digital experiences.
        Specialized in delivering website redesigns and digital assets that
        balance design, UX, and brand storytelling. Detail-oriented and
        collaborative with a strong understanding of how design translates
        across platforms to create seamless, user-centered experiences.
      </p>
    </div>
  </div>
  <img
    class="decorative-flower"
    src={Flower.src}
    width="100"
    height="100"
    alt=""
    aria-hidden="true"
  />
</section>

<style>
  /* Same horizontal band as .navbar: full width inside .main-wrapper padding */
  .masthead {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
  }

  .masthead::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--gradient-accent);
    z-index: 0;
  }

  .masthead::after {
    content: "";
    position: absolute;
    inset: 0;
    background: url("../assets/mobile-header-background.png") center / cover
      no-repeat;
    opacity: 0.3;
    z-index: 1;
    pointer-events: none;
  }

  .masthead-inner {
    position: relative;
    z-index: 2;
  }

  .header {
    position: relative;
    padding: 82px 35px 30px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 83rem;
  }

  .header h1 {
    margin-top: 0px;
  }

  .header h1,
  .header p {
    color: var(--platinum);
    margin-bottom: 0px;
  }

  .header p {
    font-size: 20px;
    line-height: 29px;
  }

  .header .subheading {
    color: var(--dust-gray);
    margin-bottom: 0px;
  }

  .decorative-flower {
    position: absolute;
    bottom: 25px;
    right: 25px;
    z-index: 2;
    width: 100px;
    height: 100px;
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .masthead::after {
      background-image: url("../assets/desktop-header-background.png");
      opacity: 0.5;
    }

    .decorative-flower {
      width: 200px;
      height: 200px;
    }

    .header .subheading {
      font-weight: bold;
      font-size: 28px;
    }
  }
</style>

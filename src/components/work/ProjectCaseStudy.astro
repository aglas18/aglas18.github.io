---
import type {
  CaseStudySection,
  WorkFrontmatter,
  WorkImage,
} from "../../pages/work/types";
import WorkGallery from "./WorkGallery.astro";
import FigmaEmbed from "./FigmaEmbed.astro";

interface Props {
  frontmatter: WorkFrontmatter;
}

const { frontmatter } = Astro.props;
const goal = frontmatter.goalSection;
const sections = frontmatter.caseSections ?? [];

function normalizeGallerySrc(src: string): string {
  return src.split("?")[0].replace(/\/+$/, "").trim().toLowerCase();
}

function collectNarrativeImageSrcs(): Set<string> {
  const used = new Set<string>();
  const add = (src: string | undefined) => {
    if (src) used.add(normalizeGallerySrc(src));
  };
  add(goal?.image?.src);
  for (const s of sections) {
    if (s.type === "mediaText") {
      add(s.image?.src);
      for (const im of s.stackBottom ?? []) add(im?.src);
    } else if (s.type === "imageGrid") {
      for (const im of s.images) add(im?.src);
    }
  }
  return used;
}

const narrativeSrcs = collectNarrativeImageSrcs();
const footerGalleryImages = frontmatter.gallery.filter(
  (img) => img?.src && !narrativeSrcs.has(normalizeGallerySrc(img.src)),
);

let nextIndex = 0;
const goalImageIndex =
  goal?.image?.src != null && goal.image.src !== "" ? nextIndex++ : null;

type Prepared =
  | {
      kind: "mediaText";
      section: Extract<CaseStudySection, { type: "mediaText" }>;
      imageIndex: number | null;
      stackBottomImages: WorkImage[];
      stackBottomIndices: (number | null)[];
    }
  | {
      kind: "imageGrid";
      section: Extract<CaseStudySection, { type: "imageGrid" }>;
      imageIndices: (number | null)[];
    }
  | { kind: "text"; section: Extract<CaseStudySection, { type: "text" }> }
  | { kind: "figma"; section: Extract<CaseStudySection, { type: "figma" }> };

const prepared: Prepared[] = [];

for (const s of sections) {
  if (s.type === "mediaText") {
    const imageIndex =
      s.image?.src != null && s.image.src !== "" ? nextIndex++ : null;
    const stackBottom = (s.stackBottom ?? [])
      .filter((im) => im?.src != null && im.src !== "")
      .slice(0, 2);
    const stackBottomIndices = stackBottom.map((im) =>
      im?.src != null && im.src !== "" ? nextIndex++ : null,
    );
    prepared.push({
      kind: "mediaText",
      section: s,
      imageIndex,
      stackBottomImages: stackBottom,
      stackBottomIndices,
    });
  } else if (s.type === "imageGrid") {
    const colsRaw = s.columns as unknown;
    const cols =
      colsRaw === 3 || colsRaw === "3" || Number(colsRaw) === 3 ? 3 : 2;
    const section: Extract<CaseStudySection, { type: "imageGrid" }> = {
      type: "imageGrid",
      columns: cols,
      images: s.images,
    };
    const imageIndices = section.images.map((im) =>
      im?.src != null && im.src !== "" ? nextIndex++ : null,
    );
    prepared.push({ kind: "imageGrid", section, imageIndices });
  } else if (s.type === "text") {
    prepared.push({ kind: "text", section: s });
  } else if (s.type === "figma") {
    prepared.push({ kind: "figma", section: s });
  }
}

const galleryStart = nextIndex;
---

<div class="case-study">
  <section class="cs-hero">
    <div class="cs-hero-text">
      <h5>{frontmatter.projectType || "Project Type"}</h5>
      <h1>{frontmatter.brand ?? frontmatter.title}</h1>
      {
        frontmatter.heroIntro && (
          <div class="cs-hero-intro" set:html={frontmatter.heroIntro} />
        )
      }
    </div>
    <img
      src={frontmatter.heroImage.src}
      alt={frontmatter.heroImage.alt}
      class="cs-hero-image"
    />
  </section>

  <section class="cs-dark-stack">
    <div class="cs-dark-band">
      <div class="cs-cards">
        <div class="card card-one">
          <h3>About the Project</h3>
          <ul>
            {frontmatter.about.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="card card-two">
          <h3>Tools used</h3>
          <ul>
            {frontmatter.tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </div>
      </div>
    </div>

    {
      goal && (
        <div class="cs-goal">
          <div class="cs-goal-inner">
            <div class="cs-goal-media">
              <div class="cs-goal-frame">
                {goalImageIndex !== null ? (
                  <img
                    src={goal.image.src}
                    alt={goal.image.alt}
                    class="gallery-image cs-zoomable"
                    data-index={goalImageIndex}
                  />
                ) : (
                  <img src={goal.image.src} alt={goal.image.alt} />
                )}
              </div>
            </div>
            <div class="cs-goal-copy">
              <h2>{goal.title}</h2>
              <div class="cs-goal-body" set:html={goal.body} />
            </div>
          </div>
        </div>
      )
    }
  </section>

  <section class="cs-body">
    {
      prepared.map((item) =>
        item.kind === "mediaText" ? (
          <div
            class:list={[
              "cs-row",
              item.section.mediaPosition === "right"
                ? "cs-row--media-right"
                : "cs-row--media-left",
            ]}
          >
            <div class="cs-row-media">
              {item.stackBottomImages.length > 0 ? (
                <div class="cs-row-media-stack">
                  <div class="cs-row-frame">
                    {item.imageIndex !== null ? (
                      <img
                        src={item.section.image.src}
                        alt={item.section.image.alt}
                        class="gallery-image cs-zoomable"
                        data-index={item.imageIndex}
                      />
                    ) : (
                      <img
                        src={item.section.image.src}
                        alt={item.section.image.alt}
                      />
                    )}
                  </div>
                  <div class="cs-row-stack-bottom">
                    {item.stackBottomImages.map((img, k) => {
                      const idx = item.stackBottomIndices[k];
                      return (
                        <div class="cs-row-stack-cell">
                          {typeof idx === "number" ? (
                            <img
                              src={img.src}
                              alt={img.alt}
                              class="gallery-image cs-zoomable"
                              data-index={idx}
                            />
                          ) : (
                            <img src={img.src} alt={img.alt} />
                          )}
                        </div>
                      );
                    })}
                  </div>
                </div>
              ) : (
                <div class="cs-row-frame">
                  {item.imageIndex !== null ? (
                    <img
                      src={item.section.image.src}
                      alt={item.section.image.alt}
                      class="gallery-image cs-zoomable"
                      data-index={item.imageIndex}
                    />
                  ) : (
                    <img
                      src={item.section.image.src}
                      alt={item.section.image.alt}
                    />
                  )}
                </div>
              )}
            </div>
            <div class="cs-row-text">
              {item.section.eyebrow && (
                <p class="cs-eyebrow cs-eyebrow--media-row">
                  {item.section.eyebrow}
                </p>
              )}
              {item.section.title && <h2>{item.section.title}</h2>}
              <div class="cs-row-body" set:html={item.section.body} />
            </div>
          </div>
        ) : item.kind === "imageGrid" ? (
          <div
            class:list={[
              "cs-grid",
              item.section.columns === 3 ? "cs-grid--3" : "cs-grid--2",
            ]}
          >
            {item.section.images.map((img, j) => {
              const li = item.imageIndices[j];
              return (
                <div class="cs-grid-cell">
                  {typeof li === "number" ? (
                    <img
                      src={img.src}
                      alt={img.alt}
                      class="gallery-image cs-zoomable"
                      data-index={li}
                    />
                  ) : (
                    <img src={img.src} alt={img.alt} />
                  )}
                </div>
              );
            })}
          </div>
        ) : item.kind === "text" ? (
          <div class="cs-text-block">
            {item.section.eyebrow && (
              <p class="cs-eyebrow">{item.section.eyebrow}</p>
            )}
            {item.section.title && <h2>{item.section.title}</h2>}
            <div class="cs-text-body" set:html={item.section.body} />
          </div>
        ) : (
          <FigmaEmbed url={item.section.url} title={frontmatter.title} />
        ),
      )
    }
  </section>

  {
    footerGalleryImages.length > 0 && (
      <WorkGallery images={footerGalleryImages} startIndex={galleryStart} />
    )
  }

  {
    frontmatter.figmaEmbed && !sections.some((s) => s.type === "figma") && (
      <FigmaEmbed url={frontmatter.figmaEmbed} title={frontmatter.title} />
    )
  }
</div>

<style>
  .case-study {
    width: 100%;
  }

  .cs-dark-stack {
    background-color: var(--ink-black);
    border-radius: 30px;
    padding: 50px 24px;
  }

  .cs-dark-band {
    padding: 0;
    margin: 0;
    background: transparent;
  }

  .cs-goal {
    padding: 48px 0 0;
    margin: 0;
    background: transparent;
    border-radius: 0;
  }

  .cs-hero {
    display: flex;
    flex-direction: column-reverse;
    gap: 0;
  }

  .cs-hero-text h1 {
    margin-top: 0;
  }

  .cs-hero-intro :global(p) {
    margin: 0.75rem 0 0;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--navy-blue);
  }

  .cs-hero-image {
    width: 100%;
    aspect-ratio: 11 / 10;
    border-radius: 20px;
    margin-bottom: 2rem;
    object-fit: cover;
    object-position: center;
  }

  .cs-dark-band .cs-cards {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .card {
    border-radius: 30px;
    padding: 35px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    justify-content: center;
    padding-left: 0;
  }

  .card li {
    list-style: none;
    padding: 10px 20px;
    width: fit-content;
    border-radius: 100px;
    text-align: center;
  }

  .card-one {
    background-color: var(--platinum);
  }

  .card-one li {
    border: solid 1px var(--navy-blue);
  }

  .card-two {
    border: solid 1px var(--platinum);
  }

  .card-two li {
    background-color: var(--platinum);
  }

  .card-two h3 {
    color: var(--platinum);
  }

  .cs-goal-inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: 100%;
    max-width: none;
    margin: 0;
  }

  .cs-goal-frame {
    border: 3px solid var(--platinum);
    border-radius: 20px;
    overflow: hidden;
    line-height: 0;
    aspect-ratio: 11 / 10;
  }

  .cs-goal-frame img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .cs-goal-copy h2 {
    color: var(--platinum);
    margin-top: 0;
  }

  .cs-goal-body :global(p),
  .cs-goal-body {
    color: var(--platinum);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.65;
  }

  .cs-goal-body :global(p) {
    margin: 0 0 0.75rem;
  }

  .cs-body {
    padding: 3rem 0 0;
  }

  .cs-body > .cs-row,
  .cs-body > .cs-grid,
  .cs-body > .cs-text-block {
    margin-bottom: 3rem;
  }

  .cs-body > :last-child {
    margin-bottom: 0;
  }

  .cs-row {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 0;
  }

  .cs-row--media-right {
    flex-direction: column-reverse;
  }

  .cs-row-media-stack {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .cs-row-stack-bottom {
    display: flex;
    flex-direction: row;
    gap: 10px;
    width: 100%;
  }

  .cs-row-stack-cell {
    flex: 1;
    min-width: 0;
    border-radius: 12px;
    overflow: hidden;
    line-height: 0;
    aspect-ratio: 5 / 4;
  }

  .cs-row-stack-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cs-row-frame {
    border-radius: 20px;
    overflow: hidden;
    line-height: 0;
    aspect-ratio: 11 / 10;
  }

  .cs-row-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cs-eyebrow {
    font-family: var(--font-primary);
    text-transform: uppercase;
    font-size: 16px;
    line-height: 24px;
    color: var(--amaranth);
    margin: 0 0 8px;
  }

  .cs-eyebrow--media-row {
    font-size: 20px;
    line-height: 28px;
    margin-bottom: 10px;
  }

  .cs-row-text h2 {
    margin-top: 0;
  }

  .cs-row-body :global(p),
  .cs-text-body :global(p) {
    margin: 0 0 0.75rem;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.65;
    color: var(--navy-blue);
  }

  .cs-grid {
    display: grid;
    gap: 16px;
    margin-bottom: 0;
  }

  .cs-grid--2 {
    grid-template-columns: 1fr;
  }

  .cs-grid--3 {
    grid-template-columns: 1fr;
  }

  .cs-grid-cell {
    border-radius: 16px;
    overflow: hidden;
    line-height: 0;
    aspect-ratio: 11 / 10;
  }

  .cs-grid-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cs-text-block {
    margin-bottom: 0;
    max-width: 720px;
  }

  .cs-text-block h2 {
    margin-top: 0;
  }

  .cs-zoomable {
    cursor: zoom-in;
  }

  @media (min-width: 769px) {
    .cs-hero {
      flex-direction: row;
      align-items: flex-end;
      gap: 50px;
      justify-content: space-between;
      padding-bottom: 100px;
    }

    .cs-hero-image {
      flex: 0.55;
      width: 55%;
      margin-bottom: 0;
    }

    .cs-body {
      padding-top: 0;
    }

    .cs-body > .cs-row,
    .cs-body > .cs-grid,
    .cs-body > .cs-text-block {
      margin-bottom: 0;
    }

    .cs-dark-stack {
      padding: 50px 48px;
    }

    .cs-dark-band .cs-cards {
      flex-direction: row;
      align-items: stretch;
      gap: 24px;
    }

    .cs-dark-band .cs-cards .card {
      flex: 1;
    }

    .cs-goal-inner {
      flex-direction: row;
      align-items: center;
      gap: 56px;
    }

    .cs-goal-media {
      flex: 0.62;
      min-width: 0;
    }

    .cs-goal-copy {
      flex: 1;
      min-width: 0;
    }

    .cs-row {
      flex-direction: row;
      align-items: center;
      gap: 48px;
    }

    .cs-row--media-right {
      flex-direction: row;
    }

    .cs-row--media-right .cs-row-media {
      order: 2;
    }

    .cs-row--media-right .cs-row-text {
      order: 1;
    }

    .cs-row-media,
    .cs-row-text {
      flex: 1;
      min-width: 0;
    }

    .cs-grid--2 {
      grid-template-columns: 1fr 1fr;
    }

    .cs-grid--3 {
      grid-template-columns: repeat(3, 1fr);
    }

    .cs-goal-frame,
    .cs-row-frame,
    .cs-grid-cell {
      aspect-ratio: auto;
    }

    .cs-row-stack-cell {
      aspect-ratio: auto;
    }

    .cs-goal-frame img {
      height: auto;
      max-height: 560px;
    }

    .cs-row-frame img {
      height: auto;
    }

    .cs-row-stack-cell img {
      height: auto;
      max-height: 280px;
    }

    .cs-eyebrow--media-row {
      font-size: 22px;
      line-height: 30px;
    }

    .cs-grid-cell img {
      height: auto;
      max-height: 615px;
    }

    .cs-row.cs-row--media-left {
      padding-top: 100px;
      padding-bottom: 100px;
    }

    .cs-row.cs-row--media-right {
      padding-bottom: 100px;
    }

    .cs-grid {
      padding-bottom: 30px;
    }

    h2 {
      margin-bottom: 22px;
    }

    h1 {
      margin-bottom: 22px;
    }
  }
</style>

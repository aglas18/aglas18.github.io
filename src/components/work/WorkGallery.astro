---
import type { WorkImage } from "../../pages/work/types";

interface Props {
  images: WorkImage[];
  /** Global lightbox index offset when inline images precede this gallery. */
  startIndex?: number;
}

const { images: rawImages, startIndex = 0 } = Astro.props;
const images = rawImages.filter((img) => img?.src);
const n = images.length;
---

{
  n === 0 ? null : n === 9 ? (
    <section class="gallery gallery--legacy">
      <div class="row row-1">
        <div class="col col-left">
          <div class="gallery-item">
            <img
              src={images[0].src}
              alt={images[0].alt}
              class="gallery-image"
              data-index={startIndex + 0}
            />
            <span class="gallery-plus-icon"></span>
          </div>

          <div class="bottom-row">
            <div class="gallery-item">
              <img
                src={images[1].src}
                alt={images[1].alt}
                class="gallery-image"
                data-index={startIndex + 1}
              />
              <span class="gallery-plus-icon"></span>
            </div>
            <div class="gallery-item">
              <img
                src={images[2].src}
                alt={images[2].alt}
                class="gallery-image"
                data-index={startIndex + 2}
              />
              <span class="gallery-plus-icon"></span>
            </div>
          </div>
        </div>

        <div class="col col-right">
          <div class="gallery-item">
            <img
              src={images[3].src}
              alt={images[3].alt}
              class="gallery-image"
              data-index={startIndex + 3}
            />
            <span class="gallery-plus-icon"></span>
          </div>
        </div>
      </div>

      <div class="row row-2">
        <div class="gallery-item">
          <img
            src={images[4].src}
            alt={images[4].alt}
            class="gallery-image"
            data-index={startIndex + 4}
          />
          <span class="gallery-plus-icon"></span>
        </div>
        <div class="gallery-item">
          <img
            src={images[5].src}
            alt={images[5].alt}
            class="gallery-image"
            data-index={startIndex + 5}
          />
          <span class="gallery-plus-icon"></span>
        </div>
      </div>

      <div class="row row-3">
        <div class="gallery-item">
          <img
            src={images[6].src}
            alt={images[6].alt}
            class="gallery-image"
            data-index={startIndex + 6}
          />
          <span class="gallery-plus-icon"></span>
        </div>
        <div class="gallery-item">
          <img
            src={images[7].src}
            alt={images[7].alt}
            class="gallery-image"
            data-index={startIndex + 7}
          />
          <span class="gallery-plus-icon"></span>
        </div>
        <div class="gallery-item">
          <img
            src={images[8].src}
            alt={images[8].alt}
            class="gallery-image"
            data-index={startIndex + 8}
          />
          <span class="gallery-plus-icon"></span>
        </div>
      </div>
    </section>
  ) : (
    <section class="gallery gallery--adaptive">
      {images.map((img, i) => (
        <div class="gallery-item gallery-item--tile">
          <img
            src={img.src}
            alt={img.alt}
            class="gallery-image"
            data-index={startIndex + i}
          />
          <span class="gallery-plus-icon"></span>
        </div>
      ))}
    </section>
  )
}

<style>
  .gallery {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .row-1,
  .row-2,
  .row-3 {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .gallery-item {
    position: relative;
    display: block;
  }

  .row-1 .gallery-item,
  .row-2 .gallery-item,
  .row-3 .gallery-item {
    width: 100%;
  }

  .row-1 .gallery-item img,
  .row-2 .gallery-item img,
  .row-3 .gallery-item img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 15px;
  }

  .gallery--adaptive {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
  }

  .gallery--adaptive .gallery-item--tile img {
    width: 100%;
    height: auto;
    min-height: 200px;
    max-height: 520px;
    object-fit: cover;
    border-radius: 15px;
  }

  .col-left,
  .col-right {
    width: 100%;
  }

  .col-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .col-left .bottom-row {
    display: flex;
    gap: 0.5rem;
  }

  .col-left .bottom-row .gallery-item {
    width: 50%;
  }

  @media (min-width: 769px) {
    .row-1 {
      flex-direction: row;
    }

    .row-1 .col-left {
      width: 50%;
      flex: 1;
    }

    .col-left .bottom-row .gallery-item {
      flex: 1;
      width: 49%;
      height: 100%;
    }

    .col-left .bottom-row .gallery-item img {
      width: 100%;
      height: 100%;
      border-radius: 8px;
    }

    .col-right {
      flex: 1;
    }

    .col-right .gallery-item {
      height: 100%;
    }

    .col-right .gallery-item img {
      width: 100%;
      height: 100%;
      border-radius: 20px;
    }

    .row-2 {
      flex-direction: row;
      height: 585px;
    }

    .row-2 .gallery-item {
      width: 50%;
      height: 100%;
    }

    .row-2 .gallery-item img {
      width: 100%;
      height: 100%;
    }

    .row-3 {
      flex-direction: row;
      height: 430px;
    }

    .row-3 .gallery-item {
      width: 33.3%;
      height: 100%;
    }

    .row-3 .gallery-item img {
      width: 100%;
      height: 100%;
    }

    .gallery--adaptive .gallery-item--tile img {
      height: 100%;
      max-height: 480px;
    }
  }

  .gallery-item img {
    cursor: zoom-in;
  }

  .gallery-plus-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 32px;
    height: 32px;
    background: url("/assets/add.svg") no-repeat center / contain;
    filter: brightness(0) invert(1);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
    z-index: 10;
    pointer-events: none;
  }

  .gallery-item::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(14, 23, 27, 0.7);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
    border-radius: 15px;
    z-index: 1;
    pointer-events: none;
  }

  .col-left .bottom-row .gallery-item::before {
    border-radius: 8px;
  }

  @media (min-width: 769px) {
    .col-right .gallery-item::before {
      border-radius: 20px;
    }
  }

  .gallery-item:hover::before {
    opacity: 1;
    visibility: visible;
  }

  .gallery-item:hover .gallery-plus-icon {
    opacity: 1;
    visibility: visible;
  }
</style>

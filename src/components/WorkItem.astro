---
import arrow from "../assets/arrow.svg";

const allWork = Object.values(
  import.meta.glob("../content/work/*.md", { eager: true })
);
---

<div class="project-items">
  {
    allWork.map((work: any) => (
      <div class="project-item">
        <img
          class="project-image"
          src={work.frontmatter.cardImage.src}
          alt={work.frontmatter.cardImage.alt}
          width="100%"
          height="100%"
        />

        <div>
          <h3>{work.frontmatter.title}</h3>
          <p>{work.frontmatter.shortDescription}</p>

          <div class="link-btn">
            <a href={`/work/${work.frontmatter.slug}`}>View Project</a>
            <a class="icon-circle">
              <img
                class="arrow"
                src={arrow.src}
                width="18"
                height="18"
                alt="arrow"
              />
            </a>
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  .icon-circle {
    background-color: var(--berry-crush);
    width: 35px;
    height: 35px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 100px;
  }

  .link-btn {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .project-item {
    background-color: #fff;
    padding: 18px;
    border-radius: 30px;
  }

  .project-image {
    border-radius: 20px;
    height: auto;
  }

  .project-items {
    display: grid;
    gap: 30px;
  }

  @media (min-width: 768px) {
    .project-items {
      grid-template-columns: repeat(2, 1fr);
    }

    .project-item:hover {
      box-shadow: 0px 0px 20px #0e171b29;
      transform: translateY(-2px);
    }

    .project-item:hover .link-btn a {
      color: var(--navy-blue);
    }

    .project-item:hover .link-btn .icon-circle {
      background-color: var(--navy-blue);
    }

    .project-item {
      transition:
        background-color 0.25s ease,
        box-shadow 0.25s ease,
        transform 0.25s ease;
    }
  }

  @media (min-width: 1280px) {
    .project-items {
      grid-template-columns: repeat(3, 1fr);
    }

    .project-item p {
      margin: 10px 0;
    }

    .project-item {
      padding: 25px;
    }

    .project-image {
      margin-bottom: 20px;
      height: 375px;
      object-fit: cover;
    }
  }
</style>

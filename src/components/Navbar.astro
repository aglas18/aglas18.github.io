---
import logo from '../assets/logo.svg';
import hamburger from '../assets/hamburger.svg';
---

<div class="flex flex-row justify-between items-center p-4 md:flex-row lg:bg-red-500 desktop:text-2xl font-black">
    <a href="#"
			><img src={logo.src} width="100" height="45" alt="Adrian Glasmyre Logo" /></a
			>
    <div class="flex flex-row items-center gap-4">
    <a class="font-facile" href="#">Contact</a>
    <a href="#"
			><img src={hamburger.src} width="24" height="22" alt="mobile menu" /></a
			>
    </div>
</div>
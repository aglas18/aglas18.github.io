---
import { experienceList, jobList } from "../content/experiences/Experiences.ts";
---

<section>
  <h2 class="flower-heading">Experiences</h2>
  <div class="accordion">
    {
      experienceList.map((experience, index) => (
        <details class="accordion-item" open={index === 0 ? true : undefined}>
          <summary class="accordion-title">
            <div>
              <h4>{experience.date}</h4>
              <h3>{experience.company}</h3>
            </div>
            <span class="accordion-icon" />
          </summary>

          <div class="accordion-content">
            {jobList
              .filter((job) => job.company === experience.company)
              .map((job) => (
                <div class="job-item">
                  <h5>{job.date}</h5>
                  <h3>{job.title}</h3>
                  <p>{job.content}</p>
                </div>
              ))}
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .accordion {
    margin: 0 auto;
  }

  .accordion-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .accordion-item {
    background-color: var(--dust-gray);
    padding: 20px 26px;
    margin-bottom: 20px;
    border-radius: 20px;
  }

  .accordion-title {
    list-style: none;
    cursor: pointer;
    font-size: 1.25rem;
    font-weight: 600;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .accordion-title::-webkit-details-marker {
    display: none;
  }

  .accordion-icon {
    width: 32px;
    height: 32px;
    background: url("../../public/assets/images/add.svg") no-repeat center /
      contain;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  /* When accordion is open, show minus */
  .accordion-item[open] .accordion-icon {
    background-image: url("../../public/assets/images/minus.svg");
  }

  .accordion-item[open] .accordion-icon {
    transform: rotate(180deg);
  }

  .accordion-item[open] .accordion-title {
    margin-bottom: 25px;
  }

  .job-item {
    background-color: var(--platinum);
    padding: 20px;
    border-radius: 30px;
  }

  .job-item :last-of-type {
    margin-bottom: 0px;
  }

  .job-item h4 {
    color: var(--amaranth);
  }

  .accordion-item:not([open]):hover {
    background-color: #fff;
  }

  .accordion-item {
    transition:
      background-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  @media (min-width: 1280px) {
    .accordion-content {
      flex-direction: row;
    }

    .job-item {
      flex: 1;
    }

    .accordion-title h4 {
      font-size: 22px;
    }

    .job-item p {
      font-size: 16px;
      line-height: 27px;
      margin-top: 10px;
    }

    .job-item h5 {
      font-size: 18px;
    }
  }
</style>

<script>
  const accordions = document.querySelectorAll(".accordion-item");

  accordions.forEach((acc) => {
    acc.addEventListener("toggle", () => {
      if (acc.open) {
        accordions.forEach((other) => {
          if (other !== acc) other.removeAttribute("open");
        });
      }
    });
  });
</script>

---
import LinkedIn from "../assets/linkedin.svg";
import Email from "../assets/Email.svg";
import Messaging from "../assets/Messaging.svg";
import logo from "../assets/logo.svg";
---

<section class="CTA">
  <div class="CTA-content">
    <h2 class="CTA-heading">Let's Talk!</h2>
    <a class="btn" href="#">Contact</a>
  </div>

  <div class="footer">
    <a class="logo" href="#"
      ><img
        src={logo.src}
        width="100"
        height="45"
        alt="Adrian Glasmyre Logo"
      /></a
    >
    <div class="right-footer">
      <div class="icons">
        <a
          class="icon-btn"
          href="https://www.linkedin.com/in/adrian-glasmyre-2139a0191/"
          ><img src={LinkedIn.src} width="17" height="17" alt="LinkedIn" /></a
        >
        <a class="icon-btn" href="mailto:aglasmyre@gmail.com"
          ><img src={Email.src} width="20" height="20" alt="Email" /></a
        >
        <a class="icon-btn" href="#"
          ><img src={Messaging.src} width="20" height="20" alt="Messaging" /></a
        >
      </div>
    </div>
  </div>
</section>

<style>
  .CTA-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .CTA-heading {
    font-size: 90px;
    text-align: center;
    line-height: 99px;
    margin-bottom: 11px;
  }

  .CTA {
    /* background: radial-gradient(
      circle at center,
      rgba(197, 109, 138, 0.64) 0%,
      rgba(239, 241, 243, 0) 70%
    ); */
    padding-top: 100px;
  }

  .footer {
    border-top: solid 1px var(--ink-black);
    padding-top: 20px;
    margin-top: 100px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 35px;
  }

  .icon-btn {
    background-color: var(--ink-black);
    padding: 15px 15px;
    border-radius: 100px;
    color: var(--platinum);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icons {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }

  .icon-btn:hover {
    background-color: var(--amaranth);
  }
</style>
